@* Hedefli paylaşım (ADR-0054 dilim 4a): rapor ve pano paylaşım panellerinin ortak rol / ekip / iş birimi seçicisi; seçilenler etiket olarak durur, seçim atama penceresinde yapılır (PickField). Seçim üst bileşenin listesindedir (yerinde değişir); yetki ve doğrulama sunucudadır. *@
@inject ApiClient Api

<div class="mb-3">
    @if (error is not null)
    {
        <div class="alert alert-danger" role="alert">
            @error
            <button type="button" class="btn btn-outline-secondary btn-sm ms-2" @onclick="LoadAsync">@Texts.Get("crm.sales.retry")</button>
        </div>
    }
    else if (options is null)
    {
        <LoadingState />
    }
    else
    {
        <label class="form-label" for="share-groups">@Texts.Get("reports.share.groups")</label>
        <PickField TKey="string" Id="share-groups" Title="@Texts.Get("reports.share.groups")" GroupLabel="@Texts.Get("reports.share.groupKind")" Icon="users"
                   Items="Items" Selected="Selected.Select(Key)" SelectedChanged="Replace" UnknownName="@(_ => Texts.Get("reports.share.unknownGroup"))" />
    }
</div>

@code {
    private static readonly (string Kind, string TitleKey)[] Kinds =
    [
        ("role", "reports.share.roles"),
        ("team", "reports.share.teams"),
        ("businessUnit", "reports.share.units"),
    ];

    private List<ShareGroupOptionDto>? options;
    private string? error;

    /// <summary>Seçili gruplar; bileşen bu listeyi yerinde değiştirir.</summary>
    [Parameter, EditorRequired] public List<ShareGroupDto> Selected { get; set; } = [];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        error = null;
        var response = await Api.GetAsync<List<ShareGroupOptionDto>>("/api/reports/share-groups");
        options = response.IsSuccess ? response.Value ?? [] : null;
        error = response.Error;
    }

    // Rol, ekip ve iş birimi tek pencerede, türüne göre gruplu listelenir; anahtar "tür:kimlik".
    private IReadOnlyList<PickItem<string>> Items =>
    [
        .. Kinds.SelectMany(kind => (options ?? []).Where(o => o.Kind == kind.Kind)
            .Select(o => new PickItem<string>(Key(o.Kind, o.Id), o.Name, Group: Texts.Get(kind.TitleKey)))),
    ];

    private static string Key(ShareGroupDto group) => Key(group.Kind, group.Id);

    private static string Key(string kind, Guid id) => $"{kind}:{id}";

    private void Replace(IReadOnlyList<string> keys)
    {
        Selected.Clear();
        foreach (var key in keys)
        {
            var separator = key.IndexOf(':');
            if (separator > 0 && Guid.TryParse(key[(separator + 1)..], out var id))
            {
                Selected.Add(new ShareGroupDto(key[..separator], id));
            }
        }
    }
}
