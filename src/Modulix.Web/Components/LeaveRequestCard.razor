@* Açılmış izin talebinin özeti ve eylemleri (ADR-0042 dilim 2). Talep değiştirilmez; durum yalnızca eylemlerle değişir (onay, ret, iptal). *@
@inject CrmLookups Lookups

<section class="record-form sectioned" aria-label="@Texts.Get("hr.leave-card.title")">
    <div class="form-toolbar">
        <div>
            <h2>@Texts.Get("hr.leave-card.title")</h2>
            <p>@WarehouseLabels.Text(Request, "employeeName") · @Lookups.Label(HrAccess.LeaveTypeList, WarehouseLabels.Text(Request, "leaveTypeKey"))</p>
        </div>
        <div class="form-toolbar-actions">
            <button type="button" class="btn btn-outline-secondary" @onclick="Closed">@Texts.Get("common.close")</button>
        </div>
    </div>

    <LeaveActionsBar Record="Request" Changed="Changed" />

    <div class="summary-card">
        <dl class="summary-facts">
            <div><dt>@Texts.Get("hr.leave.col.date")</dt><dd>@HrLabels.Range(Request)</dd></div>
            <div><dt>@Texts.Get("hr.leave.col.days")</dt><dd>@HrLabels.Days(HrLabels.Decimal(Request, "days"))</dd></div>
            <div><dt>@Texts.Get("common.field.status")</dt><dd><span class="badge @HrLabels.LeaveStatusBadge(Status)">@HrLabels.LeaveStatus(Status)</span></dd></div>
            <div><dt>@Texts.Get("hr.leave.col.approver")</dt><dd>@(WarehouseLabels.Id(Request, "approverUserId") is { } approver ? Lookups.MemberName(approver) : Texts.Get("hr.leave.hr"))</dd></div>
            @if (WarehouseLabels.Id(Request, "decidedByUserId") is { } decidedBy)
            {
                <div><dt>@Texts.Get("hr.leave-card.decided-by")</dt><dd>@Lookups.MemberName(decidedBy)</dd></div>
            }
            @if (WarehouseLabels.Text(Request, "decisionReason") is { Length: > 0 } decisionReason)
            {
                <div><dt>@Texts.Get("hr.leave-card.reason")</dt><dd>@decisionReason</dd></div>
            }
            @if (WarehouseLabels.Text(Request, "description") is { Length: > 0 } description)
            {
                <div><dt>@Texts.Get("common.field.description")</dt><dd>@description</dd></div>
            }
        </dl>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public RecordResponse Request { get; set; } = default!;

    [Parameter] public EventCallback<RecordResponse> Changed { get; set; }

    [Parameter] public EventCallback Closed { get; set; }

    private string Status => WarehouseLabels.Text(Request, "status");
}
