@* Rol seçimi: seçilen roller etiket olarak durur, seçim atama penceresinde yapılır (PickField). Seçim, verilen kümede tutulur. *@
@if (Roles.Count == 0)
{
    <EmptyState Compact="true" Title="@Texts.Get("admin.rolePicker.none")" />
}
else
{
    <PickField TKey="Guid" Id="@Id" Title="@Texts.Get("nav.app.admin.roles")" Icon="shield" Items="Items" Selected="Selected" SelectedChanged="Replace" />
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<RoleDto> Roles { get; set; } = [];

    [Parameter, EditorRequired] public HashSet<Guid> Selected { get; set; } = [];

    /// <summary>Yönetici rolü seçilebilir mi (kullanıcı yönetici mi)?</summary>
    [Parameter] public bool CanGrantAdministrator { get; set; }

    /// <summary>Pencereyi açan düğmenin kimliği.</summary>
    [Parameter] public string? Id { get; set; }

    // Sistem rolünü yalnızca yönetici verebilir: kilitli satır pencerede görünür ama değiştirilemez.
    private IReadOnlyList<PickItem<Guid>> Items =>
    [
        .. Roles.Select(role =>
        {
            var locked = role.IsSystem && !CanGrantAdministrator;
            var note = role.IsSystem ? Texts.Get(locked ? "admin.rolePicker.allPermissionsLocked" : "admin.rolePicker.allPermissions") : null;
            return new PickItem<Guid>(role.Id, role.Name, note, Locked: locked);
        }),
    ];

    private void Replace(IReadOnlyList<Guid> roleIds)
    {
        Selected.Clear();
        Selected.UnionWith(roleIds);
    }
}
