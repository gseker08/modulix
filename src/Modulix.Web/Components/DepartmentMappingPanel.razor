@* Eski İK departmanlarının Core departmanına eşlenmesi (ADR-0042 bölüm 22). Yalnızca henüz Core departmanı olmayan çalışan kartı, duyuru ya da anket
   varsa görünür. Değer, Yönetim › Departmanlar'da aynı adlı (ya da aynı ağaç yollu) tek bir etkin departmanla eşleşir; eşleşmeyen satır için o adla
   departman açılıp sayfa yenilenir. Uygulama kayıt boru hattından geçer (denetim kaydı); hesabı bağlı çalışan kullanıcının departmanını alır. *@
@inject ApiClient Api
@inject ToastService Toasts

@if (rows is { Count: > 0 } && rows.Any(Pending))
{
    <section class="settings-group" aria-label="@Texts.Get("hr.dept-map.label")">
        <h3>@Texts.Get("hr.dept-map.title")</h3>
        <p class="text-muted">
            @Texts.Get("hr.dept-map.intro")
        </p>

        @if (message is not null)
        {
            <div class="alert alert-danger" role="alert">@message</div>
        }

        <table class="table record-table">
            <caption class="visually-hidden">@Texts.Get("hr.dept-map.caption")</caption>
            <thead>
                <tr>
                    <th scope="col"><span class="th-label"><AppIcon Name="tag" Size="14" /> @Texts.Get("hr.dept-map.col.legacy")</span></th>
                    <th scope="col"><span class="th-label"><AppIcon Name="building" Size="14" /> @Texts.Get("hr.dept-map.col.unit")</span></th>
                    <th scope="col"><span class="th-label"><AppIcon Name="users" Size="14" /> @Texts.Get("hr.leave.col.employee")</span></th>
                    <th scope="col"><span class="th-label"><AppIcon Name="bell" Size="14" /> @Texts.Get("hr.dept-map.col.announcements")</span></th>
                    <th scope="col"><span class="th-label"><AppIcon Name="clipboard-list" Size="14" /> @Texts.Get("hr.dept-map.col.surveys")</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in rows.Where(Pending))
                {
                    <tr>
                        <td data-label="@Texts.Get("hr.dept-map.col.legacy")" class="primary">@row.Label</td>
                        <td data-label="@Texts.Get("hr.dept-map.col.unit")">
                            @if (row.BusinessUnitName is { } unit)
                            {
                                @unit
                            }
                            else
                            {
                                <span class="badge stage-negotiation">@Texts.Get("hr.dept-map.unmatched")</span>
                            }
                        </td>
                        <td data-label="@Texts.Get("hr.leave.col.employee")">@row.EmployeeCount</td>
                        <td data-label="@Texts.Get("hr.dept-map.col.announcements")">@row.AnnouncementCount</td>
                        <td data-label="@Texts.Get("hr.dept-map.col.surveys")">@row.SurveyCount</td>
                    </tr>
                }
            </tbody>
        </table>

        @if (rows.Any(r => Pending(r) && r.BusinessUnitId is null))
        {
            <p class="text-muted">@Texts.Get("hr.dept-map.unmatched-help")</p>
        }

        @if (rows.Any(r => Pending(r) && r.BusinessUnitId is not null))
        {
            <div class="form-actions">
                <button type="button" class="btn btn-tonal" disabled="@busy" aria-busy="@(busy ? "true" : null)" @onclick="ApplyAsync">
                    @if (busy)
                    {
                        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                    }
                    @Texts.Get("hr.dept-map.apply")
                </button>
            </div>
        }
    </section>
}

@code {
    private List<DepartmentMappingRowDto>? rows;
    private string? message;
    private bool busy;

    /// <summary>Uygulamadan sonra liste yeniden yüklenir.</summary>
    [Parameter] public EventCallback Applied { get; set; }

    protected override Task OnInitializedAsync() => LoadAsync();

    private static bool Pending(DepartmentMappingRowDto row) => row.EmployeeCount + row.AnnouncementCount + row.SurveyCount > 0;

    private async Task LoadAsync()
    {
        var result = await Api.GetAsync<List<DepartmentMappingRowDto>>("/api/hr/department-mapping");
        rows = result.Value;
    }

    private async Task ApplyAsync()
    {
        busy = true;
        message = null;
        var result = await Api.PostAsync<DepartmentMappingResultDto>("/api/hr/department-mapping", new { });
        busy = false;
        if (!result.IsSuccess)
        {
            message = result.Error;
            return;
        }

        Toasts.Success(Texts.Get("hr.dept-map.applied", result.Value!.Updated));
        await LoadAsync();
        await Applied.InvokeAsync();
    }
}
