@* Anket sonucu (ADR-0042 dilim 7): soru başına cevap sayısı, puan ortalaması ve dağılımı, seçenek dağılımı, metin cevapları. Yanıtlayan bilgisi yoktur;
   kimliği gizli ankette yanıt azsa sunucu sonucu göstermez ve nedenini söyler. Aynı özet CSV olarak indirilir (bölüm 23b). Çoklu seçimde oran,
   soruyu cevaplayanların seçeneği işaretleyen payıdır (toplamı %100'ü geçebilir). *@
@using System.Globalization
@inject ApiClient Api

<section aria-label="@Texts.Get("hr.survey-results.label")">
    <div class="list-toolbar mt-3"><h3 class="h6 mb-0 me-auto">@Texts.Get("hr.survey-results.title")</h3></div>
    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }
    else if (results is null)
    {
        <LoadingState />
    }
    else if (results.HiddenReason is { } hidden)
    {
        <p class="text-muted" role="status">@Texts.Get("hr.survey-results.responses", results.ResponseCount). @hidden</p>
    }
    else if (results.ResponseCount == 0)
    {
        <EmptyState Compact="true" Title="@Texts.Get("hr.survey-results.empty")" />
    }
    else
    {
        <div class="list-toolbar">
            <p class="text-muted mb-0 me-auto">@Texts.Get("hr.survey-results.responses", results.ResponseCount)</p>
            <a class="btn btn-tonal" href="@($"api/hr/surveys/{SurveyId}/results/export")" download><AppIcon Name="file-text" Size="16" /> @Texts.Get("hr.survey-results.export")</a>
        </div>
        @foreach (var question in results.Questions)
        {
            <div class="summary-card mb-3">
                <h4 class="h6">@question.Text</h4>
                <p class="text-muted mb-2">
                    @HrLabels.QuestionType(question.QuestionType) · @Texts.Get("hr.survey-results.answers", question.AnswerCount)@(question.Average is { } average ? " · " + Texts.Get("hr.survey-results.average", average.ToString("0.##", Turkish)) : "")
                </p>
                @if (question.Counts.Count > 0)
                {
                    <table class="table record-table">
                        <caption class="visually-hidden">@Texts.Get("hr.survey-results.distribution", question.Text)</caption>
                        <thead>
                            <tr>
                                <th scope="col">@OptionHeader(question.QuestionType)</th>
                                <th scope="col">@Texts.Get("hr.survey-results.col.answers")</th>
                                <th scope="col">@Texts.Get("hr.survey-results.col.share")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var count in question.Counts)
                            {
                                <tr>
                                    <td data-label="@OptionHeader(question.QuestionType)">@count.Option</td>
                                    <td data-label="@Texts.Get("hr.survey-results.col.answers")">@count.Count</td>
                                    <td data-label="@Texts.Get("hr.survey-results.col.share")">@(question.AnswerCount == 0 ? "—" : $"%{Math.Round(100m * count.Count / question.AnswerCount).ToString("0", Turkish)}")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                @if (question.Texts.Count > 0)
                {
                    <ul class="mb-0">
                        @foreach (var text in question.Texts)
                        {
                            <li class="preline">@text</li>
                        }
                    </ul>
                }
            </div>
        }
    }
</section>

@code {
    private static readonly CultureInfo Turkish = CultureInfo.GetCultureInfo("tr-TR");

    private SurveyResultsDto? results;
    private string? message;

    [Parameter, EditorRequired] public Guid SurveyId { get; set; }

    private static string OptionHeader(string questionType) =>
        Texts.Get(questionType == "rating" ? "hr.survey-results.col.rating" : "hr.survey-results.col.option");

    protected override async Task OnParametersSetAsync()
    {
        var result = await Api.GetAsync<SurveyResultsDto>($"/api/hr/surveys/{SurveyId}/results");
        results = result.Value;
        message = result.Error;
    }
}
