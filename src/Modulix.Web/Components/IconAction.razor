@* Satır eylemi ikon düğmesi (docs/design-system/component-catalog.md → IconAction; 22.11.2026 kararı): liste satırındaki
   "Düzenle", "Sonlandır", "Kaldır" gibi eylemler altı çizili metin bağlantısı değil, yalnızca ikonlu hayalet düğmedir.
   Label hem erişilebilir ad (aria-label) hem ipucudur (title); yıkıcı eylem için ConfirmAction Icon="…" kullanılır. *@
<button type="button" class="btn btn-ghost btn-icon btn-sm" title="@Label" aria-label="@Label" disabled="@Disabled"
        @onclick="OnClick" @attributes="Attributes">
    <AppIcon Name="@Icon" Size="16" />
</button>

@code {
    [Parameter, EditorRequired] public string Icon { get; set; } = "";

    [Parameter, EditorRequired] public string Label { get; set; } = "";

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public EventCallback OnClick { get; set; }

    [Parameter(CaptureUnmatchedValues = true)] public IReadOnlyDictionary<string, object>? Attributes { get; set; }
}
