@* Müşteri zaman çizelgesi (CRM eksik süreçler E9, dilim 1; kaynak süzgeci dilim 3): firmanın aktivite, fırsat ve teklifleri tek akışta, en yeniden eskiye. Satırlar sunucuda
   kullanıcının izni ve veri kapsamıyla süzülür; okunamayan kaynağın satırı gelmez. Sayfalama imleçlidir ("Daha eski kayıtları göster"). *@
@inject ApiClient Api

<section class="detail-section" aria-labelledby="customer-timeline-title">
    <div class="section-header">
        <h2 id="customer-timeline-title">@Texts.Get("crm.company.tab.timeline")</h2>
    </div>
    @if (summary is not null && (summary.LastEntryAt is not null || summary.Open.Count > 0))
    {
        <div class="summary" role="group" aria-label="@Texts.Get("crm.timeline.summary.aria")">
            <div class="summary-item">
                <span>@Texts.Get("crm.timeline.summary.last")</span>
                <strong>@(summary.LastEntryAt is { } last ? CrmLabels.Time(last) : "—")</strong>
                <small>@(summary.LastEntryEntityKey is { } lastKey ? KindOf(lastKey, null) : string.Empty)</small>
            </div>
            @foreach (var open in summary.Open)
            {
                <div class="summary-item">
                    <span>@OpenLabel(open.Source)</span>
                    <strong>@open.Count</strong>
                </div>
            }
        </div>
    }
    @if (available.Count > 1)
    {
        <div class="filters" role="group" aria-label="@Texts.Get("crm.timeline.filter.label")">
            <button type="button" class="chip @(selected.Count == 0 ? "active" : null)" aria-pressed="@(selected.Count == 0 ? "true" : "false")" disabled="@loading" @onclick="ClearFilterAsync">
                @Texts.Get("crm.timeline.filter.all")
            </button>
            @foreach (var key in available)
            {
                var on = selected.Contains(key);
                <button type="button" class="chip @(on ? "active" : null)" aria-pressed="@(on ? "true" : "false")" disabled="@loading" @onclick="() => ToggleSourceAsync(key)">
                    @SourceLabel(key)
                </button>
            }
        </div>
    }
    @if (error is not null)
    {
        <p class="text-muted" role="status">@error</p>
    }
    else if (items is null)
    {
        <LoadingState />
    }
    else if (items.Count == 0)
    {
        <EmptyState Compact="true" Title="@Texts.Get(selected.Count == 0 ? "crm.timeline.empty" : "crm.timeline.emptyFiltered")" />
    }
    else
    {
        <ol class="activity-timeline">
            @foreach (var item in items)
            {
                var family = item.EntityKey == CrmEntityKeys.Activity && item.Type is { } type ? ActivityLabels.Family(Lookups, type) : null;
                <li class="timeline-item @(family is null ? null : $"fam-{family}")">
                    <span class="timeline-icon" aria-hidden="true"><AppIcon Name="@Icon(item, family)" Size="16" /></span>
                    <div class="timeline-body">
                        @if (Href(item) is { } href)
                        {
                            <a href="@href"><strong>@item.Title</strong></a>
                        }
                        else
                        {
                            <strong>@item.Title</strong>
                        }
                        <span class="timeline-meta">
                            @Kind(item)
                            @if (item.Reference is { Length: > 0 } reference) { <text> · @reference</text> }
                            @if (item.OwnerId is not null) { <text> · @Lookups.MemberName(item.OwnerId)</text> }
                        </span>
                        <span class="timeline-meta">@CrmLabels.Time(item.OccurredAt)</span>
                        @if (item.Status is { } status)
                        {
                            @if (item.EntityKey is CrmEntityKeys.Opportunity or CrmTimelineKeys.OpportunityClosed)
                            {
                                <span class="badge stage-@status.ToLowerInvariant()">@CrmText.OpportunityStatusName(status)</span>
                            }
                            else if (item.EntityKey is CrmEntityKeys.Quote or CrmTimelineKeys.QuoteAccepted or CrmTimelineKeys.QuoteOutcome)
                            {
                                <span class="badge stage-@QuoteLabels.StatusBadge(status)">@QuoteLabels.Label(QuoteLabels.Statuses, status)</span>
                            }
                            else if (item.EntityKey == OrdersAccess.OrderEntityKey)
                            {
                                <span class="badge stage-@OrderLabels.StatusBadge(status)">@OrderLabels.Label(OrderLabels.Statuses, status)</span>
                            }
                            else if (item.EntityKey == ContractsAccess.ContractEntityKey)
                            {
                                <span class="badge stage-@ContractLabels.EffectiveBadge(status)">@ContractLabels.Label(ContractLabels.Effectives, status)</span>
                            }
                            else if (item.EntityKey == SupportAccess.TicketEntityKey)
                            {
                                <span class="badge stage-@SupportLabels.StatusBadge(status)">@SupportLabels.Label(SupportLabels.Statuses, status)</span>
                            }
                            else if (item.EntityKey == MarketingTimelineKeys.Delivery)
                            {
                                <span class="timeline-meta">@MarketingLabels.DeliveryStatus(status)</span>
                            }
                            else if (item.EntityKey == MarketingTimelineKeys.Response)
                            {
                                <span class="timeline-meta">@MarketingLabels.ResponseStatus(status)</span>
                            }
                            else if (family is not null)
                            {
                                <span class="timeline-meta">@ActivityLabels.Status(family, status)</span>
                            }
                        }
                    </div>
                </li>
            }
        </ol>
        @if (nextBefore is not null)
        {
            <button type="button" class="btn btn-tonal btn-sm" disabled="@loading" aria-busy="@(loading ? "true" : null)" @onclick="LoadMoreAsync">
                @Texts.Get("crm.timeline.more")
            </button>
        }
        <p class="small text-muted">@Texts.Get("crm.timeline.note")</p>
    }
</section>

@code {
    private readonly SortedSet<string> available = new(StringComparer.Ordinal);
    private readonly SortedSet<string> selected = new(StringComparer.Ordinal);
    private CustomerTimelineSummaryDto? summary;
    private List<CustomerTimelineItemDto>? items;
    private DateTimeOffset? nextBefore;
    private string? error;
    private bool loading;
    private (Guid Owner, long Version)? loadedFor;

    private Guid Owner => ContactId ?? CompanyId;

    /// <summary>Çizelgenin sahibi: firma ya da kişi (ADR-0059); ikisi birlikte verilmez, kişi verilirse kişi çizelgesi çizilir.</summary>
    [Parameter] public Guid CompanyId { get; set; }

    [Parameter] public Guid? ContactId { get; set; }

    private string Base => ContactId is { } contact ? $"/api/crm/contacts/{contact}" : $"/api/crm/companies/{CompanyId}";

    [Parameter, EditorRequired] public CrmLookups Lookups { get; set; } = default!;

    /// <summary>Firma detayındaki bir değişiklikten (yeni aktivite, fırsat) sonra çizelgeyi yeniden yüklemek için artırılan sayaç.</summary>
    [Parameter] public long Version { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (loadedFor == (Owner, Version))
        {
            return;
        }

        loadedFor = (Owner, Version);
        items = null;
        nextBefore = null;
        available.Clear();
        selected.Clear();
        summary = null;
        // Özet şeridi süzgeçten bağımsızdır ve yüklenemezse çizelge yine çalışır (şerit çizilmez).
        var summaryTask = LoadSummaryAsync();
        await LoadAsync(null);
        await summaryTask;
    }

    private async Task LoadSummaryAsync() =>
        summary = (await Api.GetAsync<CustomerTimelineSummaryDto>($"{Base}/timeline/summary")).Value;

    // Açık iş sayısının görünen adı; arayüzün tanımadığı kaynak anahtarıyla yazılır.
    private static string OpenLabel(string key) => key switch
    {
        "crm.activities" => Texts.Get("crm.timeline.open.activities"),
        "crm.opportunities" => Texts.Get("crm.timeline.open.opportunities"),
        "support.tickets" => Texts.Get("crm.timeline.open.tickets"),
        "orders.orders" => Texts.Get("crm.timeline.open.orders"),
        _ => key,
    };

    private async Task ToggleSourceAsync(string key)
    {
        if (!selected.Remove(key))
        {
            selected.Add(key);
        }

        await ReloadAsync();
    }

    private async Task ClearFilterAsync()
    {
        selected.Clear();
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        items = null;
        nextBefore = null;
        await LoadAsync(null);
    }

    // Kaynak anahtarının görünen adı; arayüzün tanımadığı kaynak anahtarıyla yazılır (süzgeç yine çalışır).
    private static string SourceLabel(string key) => key switch
    {
        "crm.activities" => Texts.Get("crm.timeline.source.activities"),
        "crm.opportunities" => Texts.Get("crm.timeline.source.opportunities"),
        "crm.quotes" => Texts.Get("crm.timeline.source.quotes"),
        "crm.leads" => Texts.Get("crm.timeline.source.leads"),
        "orders.orders" => Texts.Get("crm.timeline.source.orders"),
        "contracts.contracts" => Texts.Get("crm.timeline.source.contracts"),
        "support.tickets" => Texts.Get("crm.timeline.source.tickets"),
        "marketing.touches" => Texts.Get("crm.timeline.source.marketing"),
        _ => key,
    };

    private Task LoadMoreAsync() => LoadAsync(nextBefore);

    private async Task LoadAsync(DateTimeOffset? before)
    {
        loading = true;
        var query = new List<string>();
        if (before is { } time)
        {
            query.Add($"before={Uri.EscapeDataString(time.ToString("O", System.Globalization.CultureInfo.InvariantCulture))}");
        }

        if (selected.Count > 0)
        {
            query.Add($"sources={Uri.EscapeDataString(string.Join(',', selected))}");
        }

        var result = await Api.GetAsync<CustomerTimelineDto>($"{Base}/timeline{(query.Count == 0 ? string.Empty : "?" + string.Join('&', query))}");
        loading = false;
        if (result.Value is not { } page)
        {
            error = result.Error;
            return;
        }

        error = null;
        if (selected.Count == 0)
        {
            // Süzgeçsiz yanıt okunabilen bütün kaynakları sayar; çipler bunlardan kurulur ve süzgeçli yüklemelerde değişmez.
            available.Clear();
            available.UnionWith(page.Sources);
        }

        items ??= [];
        items.AddRange(page.Items);
        nextBefore = page.NextBefore;
    }

    private static string Icon(CustomerTimelineItemDto item, string? family) => item.EntityKey switch
    {
        CrmEntityKeys.Opportunity => "target",
        CrmEntityKeys.Quote => "file-text",
        CrmTimelineKeys.OpportunityClosed => "check-circle",
        CrmTimelineKeys.QuoteAccepted => "check",
        CrmTimelineKeys.QuoteOutcome => "file-text",
        CrmTimelineKeys.LeadConverted => "user-check",
        OrdersAccess.OrderEntityKey => "package",
        ContractsAccess.ContractEntityKey => "clipboard-list",
        SupportAccess.TicketEntityKey => "inbox",
        MarketingTimelineKeys.Delivery => "mail",
        MarketingTimelineKeys.Response => "message-square",
        CrmEntityKeys.Activity => ActivityLabels.Icon(family),
        _ => "clock",
    };

    private static string Kind(CustomerTimelineItemDto item) => KindOf(item.EntityKey, item.Type);

    private static string KindOf(string entityKey, string? type) => entityKey switch
    {
        CrmEntityKeys.Opportunity => Texts.Get("crm.timeline.kind.opportunity"),
        CrmEntityKeys.Quote => Texts.Get("crm.timeline.kind.quote"),
        CrmTimelineKeys.OpportunityClosed => Texts.Get(type == "Won" ? "crm.timeline.kind.opportunityWon" : "crm.timeline.kind.opportunityLost"),
        CrmTimelineKeys.QuoteAccepted => Texts.Get("crm.timeline.kind.quoteAccepted"),
        CrmTimelineKeys.QuoteOutcome => Texts.Get(type switch
        {
            "Rejected" => "crm.timeline.kind.quoteRejected",
            "Expired" => "crm.timeline.kind.quoteExpired",
            "Cancelled" => "crm.timeline.kind.quoteCancelled",
            _ => "crm.timeline.kind.quote",
        }),
        CrmTimelineKeys.LeadConverted => Texts.Get("crm.timeline.kind.leadConverted"),
        OrdersAccess.OrderEntityKey => Texts.Get("crm.timeline.kind.order"),
        ContractsAccess.ContractEntityKey => Texts.Get("crm.timeline.kind.contract"),
        SupportAccess.TicketEntityKey => Texts.Get("crm.timeline.kind.ticket"),
        MarketingTimelineKeys.Delivery => Texts.Get("crm.timeline.kind.delivery"),
        MarketingTimelineKeys.Response => type is { Length: > 0 } kind
            ? Texts.Get("marketing.related.response", MarketingLabels.ResponseKind(kind))
            : Texts.Get("crm.timeline.kind.campaignResponse"),
        CrmEntityKeys.Activity => Texts.Get("crm.timeline.kind.activity"),
        // Arayüzün henüz tanımadığı kaynak: satır yine görünür, türü genel adla yazılır.
        _ => Texts.Get("crm.timeline.kind.other"),
    };

    // Aktivitenin kendi sayfası yoktur (firma detayındaki Aktiviteler sekmesinden açılır).
    private static string? Href(CustomerTimelineItemDto item) => item.EntityKey switch
    {
        CrmEntityKeys.Opportunity or CrmTimelineKeys.OpportunityClosed => $"crm/firsatlar/{item.RecordId}",
        CrmEntityKeys.Quote or CrmTimelineKeys.QuoteAccepted or CrmTimelineKeys.QuoteOutcome => $"crm/teklifler/{item.RecordId}",
        CrmTimelineKeys.LeadConverted => $"crm/leadler/{item.RecordId}",
        OrdersAccess.OrderEntityKey => $"siparisler/{item.RecordId}",
        ContractsAccess.ContractEntityKey => $"sozlesmeler/{item.RecordId}",
        SupportAccess.TicketEntityKey => $"destek/talepler/{item.RecordId}",
        // Pazarlama satırlarının kayıt kimliği kampanyadır.
        MarketingTimelineKeys.Delivery or MarketingTimelineKeys.Response => $"pazarlama/kampanyalar/{item.RecordId}",
        _ => null,
    };
}
