@page "/yonetim/ekipler/{TeamId:guid}"
@inject ApiClient Api
@inject SessionState Session
@inject NavigationManager Navigation

<PageTitle>@(team?.Name ?? Texts.Get("admin.teams.col.team")) · Modulix</PageTitle>

<AuthGate Permission="@CoreAccess.ManageUsers">
    <a class="back-link" href="yonetim/ekipler">← @Texts.Get("nav.app.admin.teams")</a>

    @if (notice is not null)
    {
        <div class="alert alert-success" role="status">@notice</div>
    }

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message</div>
    }

    @if (team is null)
    {
        @if (message is null)
        {
            <LoadingState />
        }
    }
    else
    {
        @* Kimlik kartı + sol sekmeli düzen (docs/design-system/component-catalog.md → SideTabs). *@
        <div class="identity-card">
            <OwnerCell Name="@team.Name" AvatarOnly="true" />
            <div class="identity-main">
                <h1>@team.Name</h1>
                <span class="identity-sub"><AppIcon Name="users" Size="16" /> @Texts.Get("admin.userDetail.memberCount", team.Members.Count)</span>
            </div>
        </div>

        <div class="side-layout">
            <SideTabs Tabs="Sections" State="tabs" Label="@Texts.Get("admin.teams.sections")" />
            <div class="side-content">
        <TabPanel State="tabs" Key="genel">
        <form class="record-form settings-group" novalidate @onsubmit="SaveAsync" @onsubmit:preventDefault>
            <h2>@Texts.Get("admin.teams.section")</h2>
            <FormTabs Title="@Texts.Get("admin.teams.section")" Label="@Texts.Get("admin.teams.sections")">
            <div class="form-grid">
                <div>
                    <label class="form-label" for="teamName">@Texts.Get("admin.teams.name")</label>
                    <input id="teamName" class="form-control" maxlength="100" @bind="name" @bind:event="oninput" />
                    <FieldError Field="name" Errors="errors" />
                </div>
                <div>
                    <label class="form-label" for="teamDescription">@Texts.Get("common.field.description")</label>
                    <input id="teamDescription" class="form-control" maxlength="500" @bind="description" @bind:event="oninput" />
                    <FieldError Field="description" Errors="errors" />
                </div>
            </div>
            </FormTabs>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary"
                        disabled="@(busy || string.IsNullOrWhiteSpace(name) || (name.Trim() == team.Name && (description ?? "") == (team.Description ?? "")))" aria-busy="@(busy ? "true" : "false")">@Texts.Get("common.save")</button>
            </div>
        </form>

        <section class="detail-section">
            <div class="section-header"><h2>@Texts.Get("admin.teamDetail.delete")</h2></div>
            @if (!deleting)
            {
                <div class="account-actions">
                    <div>
                        <button type="button" class="btn btn-outline-danger" disabled="@busy" @onclick="() => deleting = true">@Texts.Get("admin.teamDetail.delete")</button>
                        <small class="text-muted">@Texts.Get("admin.teamDetail.deleteHint")</small>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-warning confirm" role="alertdialog">
                    <p>@Texts.Get("admin.teamDetail.deleteQuestion", team.Name)</p>
                    <button type="button" class="btn btn-danger" disabled="@busy" @onclick="DeleteAsync">@Texts.Get("admin.teamDetail.delete")</button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="() => deleting = false">@Texts.Get("common.dismiss")</button>
                </div>
            }
        </section>
        </TabPanel>
        <TabPanel State="tabs" Key="uyeler">
        @* Üyeler sayfada özet olarak durur; ekleme/çıkarma atama penceresinde (PickDialog) yapılır. *@
        <section class="detail-section">
            <div class="section-header">
                <h2>@Texts.Get("admin.roles.col.members")</h2>
                @if (members is { Count: > 0 })
                {
                    <button type="button" class="btn btn-tonal" disabled="@busy" @onclick="OpenMembers">
                        <AppIcon Name="plus" Size="16" /> @Texts.Get("admin.teamDetail.assignMembers")
                    </button>
                }
            </div>
            @if (members is null)
            {
                <LoadingState />
            }
            else if (members.Count == 0)
            {
                <EmptyState Compact="true" Title="@Texts.Get("admin.teamDetail.noUsers")" />
            }
            else if (team.Members.Count == 0)
            {
                <EmptyState Compact="true" Title="@Texts.Get("admin.teamDetail.noMembers")" />
            }
            else
            {
                <p class="text-muted small">@Texts.Get("admin.teamDetail.selected", team.Members.Count)</p>
                <div class="assigned-tags">
                    @foreach (var member in team.Members.OrderBy(m => m.DisplayName))
                    {
                        <span class="badge tag">@member.DisplayName · @member.Email</span>
                    }
                </div>
            }
        </section>
        </TabPanel>
            </div>
        </div>

        <PickDialog TKey="Guid" Open="pickingMembers" Title="@Texts.Get("admin.teamDetail.assignMembers")" Subtitle="@team.Name"
                    SearchPlaceholder="@Texts.Get("admin.teamDetail.searchMembers")" Icon="user" Items="MemberItems"
                    Selected="team.Members.Select(m => m.MembershipId)"
                    Busy="busy" Error="@dialogError" OnSave="SaveMembersAsync" OnClose="CloseMembers" />
    }
</AuthGate>

@code {
    [Parameter] public Guid TeamId { get; set; }

    private TeamDetailDto? team;
    private List<UserDto>? members;
    private bool pickingMembers;
    private readonly TabState tabs = new("genel");

    private IReadOnlyList<SideTabItem> Sections =>
    [
        new("genel", Texts.Get("admin.userDetail.tab.general"), "sliders", Errors: errors?.Count ?? 0),
        new("uyeler", Texts.Get("admin.roles.col.members"), "users", team?.Members.Count),
    ];
    private string? dialogError;
    private string name = string.Empty;
    private string? description;
    private bool busy;
    private bool deleting;
    private string? message;
    private string? notice;
    private IReadOnlyDictionary<string, string[]>? errors;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        if (!Session.Can(CoreAccess.ManageUsers))
        {
            return;
        }

        var result = await Api.GetAsync<TeamDetailDto>($"/api/teams/{TeamId}");
        message = result.Error;
        if (result.Value is { } loaded)
        {
            Show(loaded);

            // Davet bekleyenler de eklenebilir; devre dışı olanlar gösterilmez (ekipteyse yine işaretli kalır).
            var current = loaded.Members.Select(m => m.MembershipId).ToHashSet();
            var users = await Api.GetAsync<UserPageResponse>("/api/users?pageSize=100");
            members = users.Value?.Items
                .Where(u => u.Status != UserStatus.Disabled || current.Contains(u.MembershipId))
                .OrderBy(u => u.DisplayName)
                .ToList() ?? [];
        }
    }

    private void Show(TeamDetailDto loaded)
    {
        team = loaded;
        name = loaded.Name;
        description = loaded.Description;
    }

    private IReadOnlyList<PickItem<Guid>> MemberItems =>
        members?.Select(u => new PickItem<Guid>(u.MembershipId, u.DisplayName, u.Email)).ToList() ?? [];

    private void OpenMembers() => (pickingMembers, dialogError, notice) = (true, null, null);

    private void CloseMembers() => (pickingMembers, dialogError) = (false, null);

    private async Task SaveAsync()
    {
        busy = true;
        notice = null;
        var result = await Api.PutAsync<TeamDetailDto>($"/api/teams/{TeamId}", new SaveTeamRequest(name, description));
        busy = false;
        errors = result.FieldErrors;
        if (result.Value is { } saved)
        {
            Show(saved);
            (notice, message) = (Texts.Get("admin.teamDetail.saved"), null);
            return;
        }

        message = result.FieldErrors.Count > 0 ? null : result.Error;
    }

    private async Task SaveMembersAsync(IReadOnlyList<Guid> membershipIds)
    {
        busy = true;
        notice = null;
        var result = await Api.PutAsync<TeamDetailDto>($"/api/teams/{TeamId}/members", new SetTeamMembersRequest(membershipIds));
        busy = false;
        if (result.Value is { } saved)
        {
            Show(saved);
            CloseMembers();
            (notice, message) = (Texts.Get("admin.teamDetail.membersSaved", saved.Members.Count), null);
            return;
        }

        // Hata pencerenin içinde gösterilir; pencere açık kalır.
        dialogError = result.Error;
    }

    private async Task DeleteAsync()
    {
        busy = true;
        var result = await Api.DeleteAsync($"/api/teams/{TeamId}");
        busy = false;
        if (!result.IsSuccess)
        {
            (message, deleting) = (result.Error, false);
            return;
        }

        Navigation.NavigateTo("yonetim/ekipler");
    }
}
