    private async Task LoadCompaniesAsync()
    {
        companies = (await Api.GetAsync<List<OperatingCompanyDto>>("/api/companies")).Value ?? [];
        var current = (await Api.GetAsync<List<CompanyAssignment>>($"/api/memberships/{MembershipId}/companies")).Value ?? [];
        var byCompany = current.ToDictionary(a => a.CompanyId);
        assignments = companies.ToDictionary(c => c.Id, c =>
        {
            byCompany.TryGetValue(c.Id, out var assignment);
            return new CompanyAssignmentState
            {
                Selected = assignment is not null,
                ValidUntil = assignment?.ValidUntil?.LocalDateTime.Date,
                BranchId = assignment?.BranchId,
            };
        });

        branchesByCompany = [];
        foreach (var company in companies)
        {
            branchesByCompany[company.Id] = (await Api.GetAsync<List<BranchDto>>($"/api/companies/{company.Id}/branches")).Value ?? [];
        }
    }

    private string CompanySummary(OperatingCompanyDto company)
    {
        var state = assignments[company.Id];
        List<string> parts = [company.Name];
        if (company.IsDefault)
        {
            parts.Add(Texts.Get("admin.userDetail.defaultCompany"));
        }

        if (state.ValidUntil is { } until)
        {
            parts.Add(Texts.Get("admin.userDetail.until", until.ToString(Regional.DatePattern, System.Globalization.CultureInfo.InvariantCulture)));
        }

        if (state.BranchId is { } branchId
            && branchesByCompany.TryGetValue(company.Id, out var branches)
            && branches.FirstOrDefault(b => b.Id == branchId) is { } branch)
        {
            parts.Add(Texts.Get("admin.userDetail.branchOf", branch.Name));
        }

        return string.Join(" · ", parts);
    }

    private async Task SaveCompaniesAsync(IReadOnlyList<Guid> companyIds)
    {
        busy = true;
        notice = null;
        var payload = companyIds
            .Select(id => (Id: id, State: companyDraft[id]))
            .Select(entry => new CompanyAssignment(
                entry.Id,
                null,
                entry.State.ValidUntil is { } date ? new DateTimeOffset(date.Date, TimeZoneInfo.Local.GetUtcOffset(date.Date)) : null,
                entry.State.BranchId))
            .ToList();
        var result = await Api.PutAsync<bool>(
            $"/api/memberships/{MembershipId}/companies", new SetMembershipCompaniesRequest(payload));
        busy = false;
        if (!result.IsSuccess)
        {
            dialogError = result.Error;
            return;
        }

        CloseDialog();
        await LoadCompaniesAsync();
        notice = Texts.Get("admin.userDetail.companiesSaved");
        if (user?.IsCurrentUser == true)
        {
            await Session.RefreshAsync();
        }
    }

