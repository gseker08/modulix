@page "/abonelik/{Tenant}"
@layout PublicLayout
@inject ApiClient Api
@inject NavigationManager Navigation

<PageTitle>@Texts.Get("communication.public.title") · Modulix</PageTitle>

@* Oturumsuz tercih merkezi (ADR-0025 dilim 6). Belirteç adresin # parçasındadır (#t=...): sunucuya, günlüklere ve Referer başlığına gitmez; API çağrılarında gövdede taşınır.
   Sayfa açılışta hiçbir değişiklik yapmaz: abonelikten çıkış yalnızca düğmeye basılınca olur (bağlantıyı önceden açan güvenlik tarayıcıları kimseyi çıkaramaz). Adres maskelidir. *@

@if (loading)
{
    <LoadingState />
}
else if (invalid)
{
    <div class="alert alert-warning" role="alert">
        <h1 class="h5">@Texts.Get("crm.public-quote.invalid")</h1>
        <p class="mb-0">@Texts.Get("communication.public.invalid-text")</p>
    </div>
}
else if (view is not null)
{
    <article class="public-quote" aria-labelledby="pref-heading">
        <h1 id="pref-heading" class="h4">@Texts.Get("communication.public.heading")</h1>
        <p class="text-muted"><strong>@view.TenantName</strong> · @ChannelText(view.Channel) · @view.MaskedAddress</p>

        <Notice Text="@problem" Failed="true" />
        @if (done is not null)
        {
            <div class="alert alert-success" role="status">@done</div>
        }

        @switch (view.State)
        {
            case "subscribed":
                <p>@Texts.Get("communication.public.subscribed", view.TenantName)</p>
                @if (view.Topics is { Count: > 0 })
                {
                    <fieldset class="mb-3" disabled="@busy">
                        <legend class="h6">@Texts.Get("communication.public.topics")</legend>
                        @foreach (var topic in view.Topics)
                        {
                            <div class="form-check">
                                <input id="topic-@topic.Key" class="form-check-input" type="checkbox" checked="@topic.Subscribed" disabled="@(!topic.CanChange)"
                                       @onchange="e => SetTopicAsync(topic, e.Value is true)" />
                                <label class="form-check-label" for="topic-@topic.Key">@topic.Name</label>
                            </div>
                        }
                        <p class="small text-muted mb-0">@Texts.Get("communication.public.topics-help")</p>
                    </fieldset>
                }
                <div class="form-actions">
                    <button type="button" class="btn btn-primary" disabled="@busy" @onclick="UnsubscribeAsync">@Texts.Get("communication.public.unsubscribe")</button>
                </div>
                break;
            case "unsubscribed":
                <p>@Texts.Get("communication.public.unsubscribed")</p>
                @if (view.CanResubscribe)
                {
                    <p class="small text-muted">@Texts.Get("communication.public.resubscribe-help")</p>
                    <div class="form-actions">
                        <button type="button" class="btn btn-outline-secondary" disabled="@busy" @onclick="ResubscribeAsync">@Texts.Get("communication.public.resubscribe")</button>
                    </div>
                }
                break;
            default:
                <div class="alert alert-info" role="status">@view.Message</div>
                @if (view.CanUnsubscribe)
                {
                    <div class="form-actions">
                        <button type="button" class="btn btn-outline-secondary" disabled="@busy" @onclick="UnsubscribeAsync">@Texts.Get("communication.public.opt-out")</button>
                    </div>
                }
                break;
        }

        <p class="small text-muted mt-3">@Texts.Get("communication.public.scope-note")</p>
    </article>
}

@code {
    [Parameter] public string Tenant { get; set; } = string.Empty;

    private PublicCommunicationView? view;
    private string token = string.Empty;
    private string? problem;
    private string? done;
    private bool loading = true;
    private bool invalid;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        // Sayfa önce tarayıcının diliyle açılır; görünüm gelince alıcının diline geçer (ADR-0034 §6).
        await PublicTexts.ApplyAsync(Api, null);
        token = Modulix.Web.Pages.Crm.PublicQuote.TokenFromFragment(Navigation.Uri);
        if (token.Length == 0)
        {
            loading = false;
            invalid = true;
            return;
        }

        var result = await Api.PostAsync<PublicCommunicationView>($"/api/public/communication/{Uri.EscapeDataString(Tenant)}/view", new PublicCommunicationTokenRequest(token));
        if (result.Value is { } loaded)
        {
            await PublicTexts.ApplyAsync(Api, loaded.Language);
        }

        loading = false;
        view = result.Value;
        invalid = view is null;
    }

    private Task UnsubscribeAsync() => ActAsync("unsubscribe");

    private Task ResubscribeAsync() => ActAsync("resubscribe");

    private Task SetTopicAsync(PublicTopicDto topic, bool subscribed) => ActAsync("topic", new PublicTopicRequest(token, topic.Key, subscribed));

    private async Task ActAsync(string action, object? body = null)
    {
        if (busy) { return; }
        busy = true;
        problem = null;
        done = null;
        var result = await Api.PostAsync<PublicCommunicationView>(
            $"/api/public/communication/{Uri.EscapeDataString(Tenant)}/{action}", body ?? new PublicCommunicationTokenRequest(token));
        busy = false;
        if (result.Value is { } updated)
        {
            view = updated;
            done = Texts.Get("communication.public.saved");
            return;
        }

        problem = result.Error ?? Texts.Get("communication.public.failed");
    }

    private static string ChannelText(string channel) => channel switch
    {
        "Email" => Texts.Get("common.field.email"),
        "Sms" => "SMS",
        "WhatsApp" => "WhatsApp",
        "Phone" => Texts.Get("common.field.phone"),
        _ => channel,
    };
}
