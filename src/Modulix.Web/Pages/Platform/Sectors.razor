@page "/platform/sektorler"
@inject ApiClient Api

<PageTitle>@Texts.Get("platform.home.sectors") · @Texts.Get("nav.app.platform") · Modulix</PageTitle>

@* Sektör/faaliyet kataloğu (ADR-0029, Dilim B). Global katalogdur; firmalar buradan faaliyet seçer. Düğüm silinmez, pasife alınır; taşıma yoktur.
   Düğüm ve yetenek adları ile açıklamaları sunucu verisidir, çevrilmez (ADR-0034 dilim 18). *@
<PlatformGate>
    <a class="back-link" href="platform">← @Texts.Get("nav.app.platform")</a>
    <h1>@Texts.Get("platform.home.sectors")</h1>
    <p class="text-muted">@Texts.Get("platform.sectors.intro")</p>

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">
            @message
            @if (details.Count > 0)
            {
                <ul class="mb-0">
                    @foreach (var detail in details)
                    {
                        <li>@detail</li>
                    }
                </ul>
            }
        </div>
    }

    @if (catalog is null)
    {
        @if (message is null)
        {
            <LoadingState />
        }
    }
    else
    {
        <div class="form-actions">
            <button type="button" class="btn btn-primary" @onclick="() => NewNode(null)">@Texts.Get("platform.sectors.new")</button>
        </div>

        @if (form is not null)
        {
            <section class="record-form settings-group" aria-live="polite">
                <h2>@(form.Id is null ? (form.ParentName is null ? Texts.Get("platform.sectors.new") : Texts.Get("platform.sectors.newChild", form.ParentName)) : Texts.Get("platform.sectors.editTitle", form.Code))</h2>
                <form @onsubmit="SaveNodeAsync">
                    <div class="form-grid">
                        @if (form.Id is null)
                        {
                            <div>
                                <label class="form-label" for="nodeCode">@Texts.Get("platform.codeRequired")</label>
                                <input id="nodeCode" class="form-control" maxlength="50" placeholder="@Texts.Get("platform.sectors.codePlaceholder")" @bind="form.Code" @bind:event="oninput" />
                                <div class="form-text">@Texts.Get("platform.codeHint")</div>
                            </div>
                            @if (form.ParentId is not null)
                            {
                                <div>
                                    <label class="form-label" for="nodeKind">@Texts.Get("common.field.kind")</label>
                                    <select id="nodeKind" class="form-select" @bind="form.Kind">
                                        @foreach (var (key, label) in PlatformLabels.NodeKinds.Where(k => k.Key != PlatformLabels.SectorKind))
                                        {
                                            <option value="@key">@label</option>
                                        }
                                    </select>
                                </div>
                            }
                        }
                        <div>
                            <label class="form-label" for="nodeName">@Texts.Get("common.field.nameRequired")</label>
                            <input id="nodeName" class="form-control" maxlength="100" @bind="form.Name" @bind:event="oninput" />
                        </div>
                        <div>
                            <label class="form-label" for="nodeOrder">@Texts.Get("platform.sectors.order")</label>
                            <input id="nodeOrder" class="form-control" type="number" @bind="form.SortOrder" />
                        </div>
                        @if (form.Id is not null)
                        {
                            <div>
                                <label class="form-label" for="nodeReadiness">@Texts.Get("platform.sectors.readiness")</label>
                                <select id="nodeReadiness" class="form-select" @bind="form.Readiness">
                                    @foreach (var (key, label) in PlatformLabels.NodeReadinesses)
                                    {
                                        <option value="@key">@label</option>
                                    }
                                </select>
                            </div>
                        }
                        <div>
                            <label class="form-label" for="nodeDescription">@Texts.Get("common.field.description")</label>
                            <textarea id="nodeDescription" class="form-control" rows="2" maxlength="500" @bind="form.Description"></textarea>
                        </div>
                    </div>

                    @if (form.Id is not null)
                    {
                        <fieldset class="mt-3">
                            <legend class="form-label">@Texts.Get("platform.sectors.requiredCapabilities")</legend>
                            @if (catalog.Capabilities.Count == 0)
                            {
                                <p class="text-muted">@Texts.Get("platform.sectors.noCapabilities")</p>
                            }
                            @foreach (var capability in catalog.Capabilities)
                            {
                                <label class="form-check">
                                    <input class="form-check-input" type="checkbox" checked="@form.Capabilities.Contains(capability.Code)"
                                           @onchange="e => ToggleCapability(capability.Code, (bool)e.Value!)" />
                                    <span class="form-check-label">@capability.Name <code>@capability.Code</code></span>
                                </label>
                            }
                        </fieldset>
                    }

                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary" disabled="@(busy || string.IsNullOrWhiteSpace(form.Name) || (form.Id is null && string.IsNullOrWhiteSpace(form.Code)))">@Texts.Get("common.save")</button>
                        <button type="button" class="btn btn-outline-secondary" disabled="@busy" @onclick="() => form = null">@Texts.Get("common.dismiss")</button>
                    </div>
                </form>
            </section>
        }

        @if (catalog.Nodes.Count == 0)
        {
            <p class="text-muted">@Texts.Get("platform.sectors.emptyCatalog")</p>
        }
        else
        {
            <section class="detail-section">
                <h2>@Texts.Get("platform.sectors.tree")</h2>
                <table class="table record-table">
                    <thead><tr><th>@Texts.Get("common.field.name")</th><th>@Texts.Get("common.field.kind")</th><th>@Texts.Get("warehouse.code")</th><th>@Texts.Get("platform.sectors.readiness")</th><th>@Texts.Get("common.field.status")</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var row in Rows())
                        {
                            <tr>
                                <td data-label="@Texts.Get("common.field.name")" class="primary">@(new string('—', row.Depth) + (row.Depth > 0 ? " " : string.Empty))@row.Node.Name</td>
                                <td data-label="@Texts.Get("common.field.kind")">@PlatformLabels.NodeKindOf(row.Node.Kind)</td>
                                <td data-label="@Texts.Get("warehouse.code")"><code>@row.Node.Code</code></td>
                                <td data-label="@Texts.Get("platform.sectors.readiness")">
                                    <span class="badge @(row.Node.Readiness == PlatformLabels.Available ? "success" : "tag")">@PlatformLabels.NodeReadinessOf(row.Node.Readiness)</span>
                                </td>
                                <td data-label="@Texts.Get("common.field.status")">
                                    <span class="badge @(row.Node.IsActive ? "success" : "category")">@WarehouseLabels.ActiveText(row.Node.IsActive)</span>
                                </td>
                                <td class="actions">
                                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => Edit(row.Node)">@Texts.Get("common.edit")</button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => NewNode(row.Node)">@Texts.Get("platform.sectors.addChild")</button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@busy" @onclick="() => SetActiveAsync(row.Node)">
                                        @(row.Node.IsActive ? Texts.Get("admin.subProfiles.deactivate") : Texts.Get("admin.subProfiles.activate"))
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>
        }

        <section class="detail-section">
            <h2>@Texts.Get("platform.sectors.capabilities")</h2>
            <p class="text-muted">@Texts.Get("platform.sectors.capabilitiesIntro")</p>
            <form class="form-actions" @onsubmit="CreateCapabilityAsync">
                <input class="form-control" aria-label="@Texts.Get("platform.sectors.capabilityCode")" maxlength="100" placeholder="@Texts.Get("platform.sectors.capabilityCodePlaceholder")" @bind="capabilityCode" @bind:event="oninput" />
                <input class="form-control" aria-label="@Texts.Get("platform.sectors.capabilityName")" maxlength="100" placeholder="@Texts.Get("common.field.name")" @bind="capabilityName" @bind:event="oninput" />
                <button type="submit" class="btn btn-outline-secondary" disabled="@(busy || string.IsNullOrWhiteSpace(capabilityCode) || string.IsNullOrWhiteSpace(capabilityName))">@Texts.Get("platform.sectors.addCapability")</button>
            </form>

            @if (catalog.Capabilities.Count > 0)
            {
                <table class="table record-table">
                    <thead><tr><th>@Texts.Get("common.field.name")</th><th>@Texts.Get("warehouse.code")</th><th>@Texts.Get("platform.sectors.dependsOn")</th></tr></thead>
                    <tbody>
                        @foreach (var capability in catalog.Capabilities)
                        {
                            <tr>
                                <td data-label="@Texts.Get("common.field.name")" class="primary">@capability.Name</td>
                                <td data-label="@Texts.Get("warehouse.code")"><code>@capability.Code</code></td>
                                <td data-label="@Texts.Get("platform.sectors.dependsOn")">
                                    @foreach (var other in catalog.Capabilities.Where(c => c.Code != capability.Code))
                                    {
                                        <label class="form-check">
                                            <input class="form-check-input" type="checkbox" disabled="@busy" checked="@capability.DependsOn.Contains(other.Code)"
                                                   @onchange="e => SetDependencyAsync(capability, other.Code, (bool)e.Value!)" />
                                            <span class="form-check-label">@other.Name</span>
                                        </label>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>
    }
</PlatformGate>

@code {
    private SectorCatalogResponse? catalog;
    private NodeForm? form;
    private string? message;
    private List<string> details = [];
    private bool busy;
    private string capabilityCode = string.Empty;
    private string capabilityName = string.Empty;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var result = await Api.GetAsync<SectorCatalogResponse>("/api/platform/sectors");
        catalog = result.Value;
        Report(result.Error, result.FieldErrors);
    }

    private IEnumerable<(ActivityNodeDto Node, int Depth)> Rows()
    {
        var byParent = catalog!.Nodes.ToLookup(n => n.ParentId);
        IEnumerable<(ActivityNodeDto, int)> Walk(Guid? parentId, int depth) =>
            byParent[parentId].OrderBy(n => n.SortOrder).ThenBy(n => n.Name).SelectMany(n => Walk(n.Id, depth + 1).Prepend((n, depth)));
        return Walk(null, 0);
    }

    private void NewNode(ActivityNodeDto? parent)
    {
        form = new NodeForm
        {
            ParentId = parent?.Id,
            ParentName = parent?.Name,
            Kind = parent is null ? "Sector" : parent.Kind == "Sector" ? "Group" : "Activity",
        };
    }

    private void Edit(ActivityNodeDto node)
    {
        form = new NodeForm
        {
            Id = node.Id,
            Code = node.Code,
            Kind = node.Kind,
            Name = node.Name,
            Description = node.Description,
            SortOrder = node.SortOrder,
            Readiness = node.Readiness,
            Version = node.Version,
            Capabilities = [.. node.Capabilities],
        };
    }

    private void ToggleCapability(string code, bool on)
    {
        if (on)
        {
            form!.Capabilities.Add(code);
        }
        else
        {
            form!.Capabilities.Remove(code);
        }
    }

    private async Task SaveNodeAsync()
    {
        busy = true;
        if (form!.Id is { } id)
        {
            var updated = await Api.PutAsync<ActivityNodeDto>($"/api/platform/sectors/nodes/{id}",
                new UpdateActivityNodeRequest(form.Name, form.Description, form.SortOrder, form.Readiness, form.Version));
            Report(updated.Error, updated.FieldErrors);
            if (updated.Value is { } node)
            {
                form.Version = node.Version;
                // Yetenekler ayrı uçtan yazılır; ad ve sıra kaydedildikten sonra bağlanır.
                var linked = await Api.PutAsync<ActivityNodeDto>($"/api/platform/sectors/nodes/{id}/capabilities", new CodeListRequest([.. form.Capabilities]));
                Report(linked.Error, linked.FieldErrors);
                if (linked.Value is not null)
                {
                    form = null;
                    await LoadAsync();
                }
            }
        }
        else
        {
            var created = await Api.PostAsync<ActivityNodeDto>("/api/platform/sectors/nodes",
                new CreateActivityNodeRequest(form.Code, form.ParentId, form.Kind, form.Name, form.Description, form.SortOrder));
            Report(created.Error, created.FieldErrors);
            if (created.Value is not null)
            {
                form = null;
                await LoadAsync();
            }
        }

        busy = false;
    }

    private async Task SetActiveAsync(ActivityNodeDto node)
    {
        busy = true;
        var result = await Api.PutAsync<ActivityNodeDto>($"/api/platform/sectors/nodes/{node.Id}/active", new SetActiveRequest(!node.IsActive));
        Report(result.Error, result.FieldErrors);
        if (result.Value is not null)
        {
            await LoadAsync();
        }

        busy = false;
    }

    private async Task CreateCapabilityAsync()
    {
        busy = true;
        var result = await Api.PostAsync<CapabilityDto>("/api/platform/sectors/capabilities", new CreateCapabilityRequest(capabilityCode.Trim(), capabilityName.Trim()));
        Report(result.Error, result.FieldErrors);
        if (result.Value is not null)
        {
            capabilityCode = capabilityName = string.Empty;
            await LoadAsync();
        }

        busy = false;
    }

    private async Task SetDependencyAsync(CapabilityDto capability, string code, bool on)
    {
        busy = true;
        List<string> wanted = on ? [.. capability.DependsOn, code] : [.. capability.DependsOn.Where(c => c != code)];
        var result = await Api.PutAsync<CapabilityDto>($"/api/platform/sectors/capabilities/{Uri.EscapeDataString(capability.Code)}/dependencies", new CodeListRequest(wanted));
        Report(result.Error, result.FieldErrors);
        await LoadAsync(); // reddedilen değişiklikte (ör. döngü) kutu veritabanındaki duruma döner

        busy = false;
    }

    private void Report(string? error, IReadOnlyDictionary<string, string[]>? fieldErrors)
    {
        message = error;
        details = fieldErrors is null ? [] : [.. fieldErrors.Values.SelectMany(v => v)];
    }

    private sealed class NodeForm
    {
        public Guid? Id { get; set; }

        public Guid? ParentId { get; set; }

        public string? ParentName { get; set; }

        public string Code { get; set; } = string.Empty;

        public string Kind { get; set; } = "Sector";

        public string Name { get; set; } = string.Empty;

        public string? Description { get; set; }

        public int SortOrder { get; set; }

        public string Readiness { get; set; } = "CatalogOnly";

        public long Version { get; set; }

        public HashSet<string> Capabilities { get; set; } = [];
    }
}
