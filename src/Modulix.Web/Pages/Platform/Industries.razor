@page "/platform/firma-sektorleri"
@inject ApiClient Api

<PageTitle>@Texts.Get("nav.app.platform.industries") · @Texts.Get("nav.app.platform") · Modulix</PageTitle>

@* Firma sektörü kataloğu (ADR-0043). Firma ve müşteri adayı formlarındaki "Sektör" alanı bu listeden seçilir; bütün modüller aynı listeyi kullanır.
   Faaliyet ağacından (Sektörler ve faaliyetler) ayrıdır: ağaç firmanın hangi işi yaptığını, bu liste firmanın hangi sektörde olduğunu söyler.
   Sektör silinmez, pasife alınır; kayıtlardaki değer korunur. Sektör adları sunucu verisidir, çevrilmez (ADR-0034 dilim 18). *@
<PlatformGate>
    <a class="back-link" href="platform">← @Texts.Get("nav.app.platform")</a>
    <h1>@Texts.Get("nav.app.platform.industries")</h1>
    <p class="text-muted">@Texts.Get("platform.industries.intro")</p>

    <Notice Text="@notice" Failed="failed" />

    <div class="list-toolbar">
        <form class="search" @onsubmit:preventDefault>
            <input id="industrySearch" class="form-control" type="search" maxlength="100" placeholder="@Texts.Get("platform.industries.searchPlaceholder")" aria-label="@Texts.Get("platform.industries.search")" @bind="search" @bind:event="oninput" />
        </form>
        @if (!adding)
        {
            <button type="button" class="btn btn-primary" @onclick="StartNew"><AppIcon Name="plus" Size="16" /> @Texts.Get("platform.industries.new")</button>
        }
    </div>

    @if (adding)
    {
        <form class="record-form settings-group" novalidate @onsubmit="AddAsync" @onsubmit:preventDefault>
            <h2>@Texts.Get("platform.industries.new")</h2>
            <div class="form-grid">
                <div>
                    <label class="form-label" for="industryName">@Texts.Get("common.field.nameRequired")</label>
                    <input id="industryName" class="form-control" maxlength="100" placeholder="@Texts.Get("platform.industries.namePlaceholder")" @bind="draftName" @bind:event="oninput" @onchange="SuggestCode" />
                </div>
                <div>
                    <label class="form-label" for="industryCode">@Texts.Get("platform.codeRequired")</label>
                    <input id="industryCode" class="form-control" maxlength="50" placeholder="@Texts.Get("platform.industries.codePlaceholder")" @bind="draftCode" @bind:event="oninput" @onchange="() => codeEdited = true" />
                    <div class="form-text">@Texts.Get("platform.codeHint")</div>
                </div>
            </div>
            <div class="form-actions">
                <button type="button" class="btn btn-outline-secondary" @onclick="Cancel">@Texts.Get("common.cancel")</button>
                <button type="submit" class="btn btn-primary" disabled="@busy" aria-busy="@(busy ? "true" : "false")">@Texts.Get("common.add")</button>
            </div>
        </form>
    }

    @if (industries is null)
    {
        <LoadingState />
    }
    else if (industries.Count == 0)
    {
        <EmptyState Compact="true" Title="@Texts.Get("platform.industries.empty")" />
    }
    else
    {
        var shown = Filtered;
        <p class="text-muted" role="status">@(search.Length > 0
            ? Texts.Get("platform.industries.countsFiltered", industries.Count(i => i.IsActive), industries.Count(i => !i.IsActive), shown.Count)
            : Texts.Get("platform.industries.counts", industries.Count(i => i.IsActive), industries.Count(i => !i.IsActive)))</p>
        @if (shown.Count == 0)
        {
            <EmptyState Icon="search" Title="@Texts.Get("platform.industries.noMatch")" />
        }
        else
        {
            <table class="table record-table">
                <thead>
                    <tr>
                        <th scope="col"><SortHeader Label="@Texts.Get("common.field.name")" ColumnIcon="type" Asc="name" Desc="-name" Value="@sort" Default="" ValueChanged="SortBy" /></th>
                        <th scope="col"><SortHeader Label="@Texts.Get("warehouse.code")" ColumnIcon="hash" Asc="code" Desc="-code" Value="@sort" Default="" ValueChanged="SortBy" /></th>
                        <th scope="col"><SortHeader Label="@Texts.Get("common.field.status")" ColumnIcon="tag" Asc="active" Desc="-active" Value="@sort" Default="" ValueChanged="SortBy" /></th>
                        <th scope="col"><span class="visually-hidden">@Texts.Get("common.actions")</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var industry in ClientSort.Apply(shown, sort, SortColumns))
                    {
                        <tr>
                            <td data-label="@Texts.Get("common.field.name")" class="primary">@industry.Name</td>
                            <td data-label="@Texts.Get("warehouse.code")"><code>@industry.Code</code></td>
                            <td data-label="@Texts.Get("common.field.status")"><span class="badge @(industry.IsActive ? "user-active" : "user-disabled")">@WarehouseLabels.ActiveText(industry.IsActive)</span></td>
                            <td class="actions">
                                <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@busy" aria-label="@(industry.IsActive ? Texts.Get("platform.industries.deactivateOf", industry.Name) : Texts.Get("platform.industries.activateOf", industry.Name))"
                                        @onclick="() => SetActiveAsync(industry, !industry.IsActive)">@(industry.IsActive ? Texts.Get("admin.subProfiles.deactivate") : Texts.Get("admin.subProfiles.activate"))</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
</PlatformGate>

@code {
    private List<IndustryDto>? industries;
    private string search = string.Empty;
    private bool adding;
    private string draftName = string.Empty;
    private string draftCode = string.Empty;
    private bool codeEdited;
    private string? notice;
    private bool failed;
    private bool busy;

    // Liste tamamı yüklü geldiği için sıralama istemcidedir (ClientSort); boş değer sunucunun sırasıdır.
    private string sort = "";

    private void SortBy(string value) => sort = value;

    private static readonly Dictionary<string, Func<IndustryDto, object?>> SortColumns = new()
    {
        ["name"] = i => i.Name,
        ["code"] = i => i.Code,
        ["active"] = i => i.IsActive,
    };

    private List<IndustryDto> Filtered
    {
        get
        {
            var term = search.Trim();
            var tr = System.Globalization.CultureInfo.GetCultureInfo("tr-TR").CompareInfo;
            return [.. (industries ?? [])
                .Where(i => term.Length == 0
                    || tr.IndexOf(i.Name, term, System.Globalization.CompareOptions.IgnoreCase) >= 0
                    || i.Code.Contains(term, StringComparison.OrdinalIgnoreCase))
                .OrderBy(i => !i.IsActive)
                .ThenBy(i => i.Name, StringComparer.Create(System.Globalization.CultureInfo.GetCultureInfo("tr-TR"), true))];
        }
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var result = await Api.GetAsync<List<IndustryDto>>("/api/platform/sectors/industries");
        industries = result.Value;
        if (!result.IsSuccess)
        {
            (notice, failed) = (result.Error, true);
        }
    }

    private void StartNew()
    {
        (adding, draftName, draftCode, codeEdited, notice) = (true, string.Empty, string.Empty, false, null);
    }

    private void Cancel() => adding = false;

    /// <summary>Kod elle değiştirilmediyse addan türetilir (Türkçe harfler sadeleştirilir); kullanıcı yine düzenleyebilir.</summary>
    private void SuggestCode()
    {
        if (!codeEdited)
        {
            draftCode = IndustryCodeSuggestion.FromName(draftName);
        }
    }

    private async Task AddAsync()
    {
        if (string.IsNullOrWhiteSpace(draftName) || string.IsNullOrWhiteSpace(draftCode))
        {
            (notice, failed) = (Texts.Get("platform.industries.required"), true);
            return;
        }

        busy = true;
        var result = await Api.PostAsync<IndustryDto>("/api/platform/sectors/industries", new CreateIndustryRequest(draftCode.Trim(), draftName.Trim()));
        busy = false;
        if (!result.IsSuccess)
        {
            (notice, failed) = (result.Error, true);
            return;
        }

        (notice, failed, adding) = (Texts.Get("platform.industries.added", draftName.Trim()), false, false);
        await LoadAsync();
    }

    private async Task SetActiveAsync(IndustryDto industry, bool active)
    {
        busy = true;
        var result = await Api.PutAsync<IndustryDto>($"/api/platform/sectors/industries/{industry.Code}/active", new SetActiveRequest(active));
        busy = false;
        if (!result.IsSuccess)
        {
            (notice, failed) = (result.Error, true);
            return;
        }

        (notice, failed) = (active ? Texts.Get("platform.industries.activated", industry.Name) : Texts.Get("platform.industries.deactivated", industry.Name), false);
        await LoadAsync();
    }
}
