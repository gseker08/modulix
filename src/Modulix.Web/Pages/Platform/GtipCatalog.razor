@page "/platform/gtip"
@using Microsoft.AspNetCore.Components.Forms
@using Modulix.Shared.Customs
@inject ApiClient Api

<PageTitle>@Texts.Get("nav.app.platform.gtip") · @Texts.Get("nav.app.platform") · Modulix</PageTitle>

@* Global GTİP kataloğu (ADR-0032 K9). Bakanlık tarife cetveli yürürlük tarihli sürümler olarak yüklenir; bir tarihte o günü geçmemiş en yeni
   sürüm geçerlidir. Katalog yalnızca uyarı içindir: katalogda olmayan kod hiçbir kaydı engellemez. Hatalı dosya kısmen yüklenmez.
   GTİP kodları ve tanımları, sürüm adları ve sunucunun satır hata iletileri veridir, çevrilmez (ADR-0034 dilim 18). *@
<PlatformGate>
    <a class="back-link" href="platform">← @Texts.Get("nav.app.platform")</a>
    <h1>@Texts.Get("nav.app.platform.gtip")</h1>
    @* Kalın yazılan sütun başlıkları dosyada aranan adlardır (içe aktarıcı Türkçe başlık bekler); dile göre değişmez. *@
    <p class="text-muted">@Texts.Strong("platform.gtip.intro", "GTİP", "Tanım", "Birim")</p>

    <Notice Text="@notice" Failed="@failed" />

    <form class="record-form settings-group" novalidate @onsubmit="ImportAsync" @onsubmit:preventDefault>
        <h2>@Texts.Get("platform.gtip.upload")</h2>
        <div class="form-grid">
            <div>
                <label class="form-label" for="gtip-name">@Texts.Get("platform.gtip.versionNameRequired")</label>
                <input id="gtip-name" class="form-control" maxlength="100" placeholder="@Texts.Get("platform.gtip.namePlaceholder")" @bind="name" @bind:event="oninput" />
            </div>
            <div>
                <label class="form-label" for="gtip-date">@Texts.Get("platform.gtip.effectiveFromRequired")</label>
                <input id="gtip-date" class="form-control" type="date" @bind="effectiveFrom" />
                <div class="form-text">@Texts.Get("platform.gtip.effectiveFromHint")</div>
            </div>
            <div>
                <label class="form-label" for="gtip-file">@Texts.Get("admin.importNew.file")</label>
                <InputFile @key="inputKey" id="gtip-file" class="form-control" accept=".xlsx,.csv,.txt" OnChange="OnFileChosenAsync" disabled="@busy" />
                <div class="form-text">@Texts.Get("platform.gtip.fileHint", GtipImportLimits.MaxFileBytes / (1024 * 1024))</div>
            </div>
        </div>

        @if (preview is not null)
        {
            <div class="mt-3" aria-live="polite">
                @if (preview.FatalError is not null)
                {
                    <div class="alert alert-danger" role="alert">@preview.FatalError</div>
                }
                else
                {
                    <p>
                        @Texts.Strong("platform.gtip.validRows", preview.ValidCount.ToString(System.Globalization.CultureInfo.InvariantCulture))
                        @if (preview.HeadingRows > 0) { <text> · @Texts.Get("platform.gtip.headingRows", preview.HeadingRows)</text> }
                        @if (preview.PaddedCodes > 0) { <text> · @Texts.Get("platform.gtip.paddedCodes", preview.PaddedCodes)</text> }
                        @if (preview.ErrorCount > 0) { <text> · <strong>@Texts.Get("platform.gtip.errorRows", preview.ErrorCount)</strong></text> }
                    </p>
                    @if (preview.ErrorCount > 0)
                    {
                        <div class="alert alert-danger" role="alert">@Texts.Get("platform.gtip.hasErrors")</div>
                        <table class="table record-table">
                            <caption class="visually-hidden">@Texts.Get("platform.gtip.errorsCaption")</caption>
                            <thead><tr><th scope="col">@Texts.Get("warehouse.line")</th><th scope="col">@Texts.Get("admin.importRun.error")</th></tr></thead>
                            <tbody>
                                @foreach (var error in preview.Errors)
                                {
                                    <tr><td data-label="@Texts.Get("warehouse.line")" class="primary">@error.Row</td><td data-label="@Texts.Get("admin.importRun.error")">@error.Message</td></tr>
                                }
                            </tbody>
                        </table>
                        @if (preview.ErrorCount > preview.Errors.Count)
                        {
                            <p class="text-muted">@Texts.Get("platform.gtip.firstErrors", preview.Errors.Count)</p>
                        }
                    }
                    else if (preview.Sample.Count > 0)
                    {
                        <table class="table record-table">
                            <caption class="visually-hidden">@Texts.Get("platform.gtip.sampleCaption")</caption>
                            <thead><tr><th scope="col">@Texts.Get("warehouse.gtip")</th><th scope="col">@Texts.Get("platform.gtip.description")</th><th scope="col">@Texts.Get("warehouse.unit")</th></tr></thead>
                            <tbody>
                                @foreach (var entry in preview.Sample)
                                {
                                    <tr>
                                        <td data-label="@Texts.Get("warehouse.gtip")" class="primary">@entry.Code</td>
                                        <td data-label="@Texts.Get("platform.gtip.description")">@entry.Description</td>
                                        <td data-label="@Texts.Get("warehouse.unit")">@(entry.Unit ?? "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <p class="text-muted">@Texts.Get("platform.gtip.firstRows", preview.Sample.Count)</p>
                    }
                }
            </div>
        }

        <div class="form-actions">
            <button type="button" class="btn btn-outline-secondary" disabled="@(busy || bytes is null)" @onclick="PreviewAsync">@Texts.Get("platform.gtip.preview")</button>
            <button type="submit" class="btn btn-primary" disabled="@(busy || preview is not { CanImport: true })">
                @if (busy)
                {
                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                }
                @Texts.Get("platform.gtip.import")
            </button>
        </div>
    </form>

    <h2 class="mt-4">@Texts.Get("platform.versions")</h2>
    @if (versions is null)
    {
        <LoadingState Kind="LoadingKind.Table" />
    }
    else if (versions.Count == 0)
    {
        <p class="text-muted" role="status">@Texts.Get("platform.gtip.noVersions")</p>
    }
    else
    {
        <table class="table record-table">
            <caption class="visually-hidden">@Texts.Get("platform.gtip.versionsCaption")</caption>
            <thead>
                <tr>
                    <th scope="col"><SortHeader Label="@Texts.Get("platform.health.version")" ColumnIcon="type" Asc="name" Desc="-name" Value="@versionSort" Default="" ValueChanged="SortVersions" /></th>
                    <th scope="col"><SortHeader Label="@Texts.Get("platform.gtip.col.effectiveFrom")" ColumnIcon="calendar" Asc="effectiveFrom" Desc="-effectiveFrom" Value="@versionSort" Default="" ValueChanged="SortVersions" /></th>
                    <th scope="col"><SortHeader Label="@Texts.Get("warehouse.line")" ColumnIcon="hash" Asc="entryCount" Desc="-entryCount" Value="@versionSort" Default="" ValueChanged="SortVersions" /></th>
                    <th scope="col"><SortHeader Label="@Texts.Get("admin.importRun.file")" ColumnIcon="file-text" Asc="file" Desc="-file" Value="@versionSort" Default="" ValueChanged="SortVersions" /></th>
                    <th scope="col"><SortHeader Label="@Texts.Get("platform.gtip.col.uploaded")" ColumnIcon="clock" Asc="createdAt" Desc="-createdAt" Value="@versionSort" Default="" ValueChanged="SortVersions" /></th>
                    <th scope="col"><span class="visually-hidden">@Texts.Get("common.actions")</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var version in ClientSort.Apply(versions, versionSort, VersionColumns))
                {
                    <tr>
                        <td data-label="@Texts.Get("platform.health.version")" class="primary">
                            @version.Name
                            @if (version.Id == InForceId)
                            {
                                <span class="badge status-customer">@Texts.Get("platform.gtip.inForce")</span>
                            }
                        </td>
                        <td data-label="@Texts.Get("platform.gtip.col.effectiveFrom")">@version.EffectiveFrom.ToString("dd.MM.yyyy")</td>
                        <td data-label="@Texts.Get("warehouse.line")">@version.EntryCount</td>
                        <td data-label="@Texts.Get("admin.importRun.file")">@(version.SourceFileName ?? "—")</td>
                        <td data-label="@Texts.Get("platform.gtip.col.uploaded")">@CrmLabels.Time(version.CreatedAt)</td>
                        <td class="actions">
                            @if (confirmDelete == version.Id)
                            {
                                <span class="me-2">@Texts.Get("platform.gtip.confirmDelete")</span>
                                <button type="button" class="btn btn-outline-danger btn-sm" disabled="@busy" @onclick="() => DeleteAsync(version)">@Texts.Get("common.view.deleteYes")</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => confirmDelete = null">@Texts.Get("common.dismiss")</button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => OpenEntriesAsync(version)">@Texts.Get("warehouse.linesPanel.title")</button>
                                <button type="button" class="btn btn-outline-danger btn-sm" disabled="@busy" @onclick="() => confirmDelete = version.Id">@Texts.Get("common.delete")</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <p class="text-muted">@Texts.Get("platform.gtip.deleteNote")</p>
    }

    @if (selected is not null)
    {
        <section class="settings-group" aria-label="@Texts.Get("platform.gtip.entries")">
            <h2>@Texts.Get("platform.gtip.entriesTitle", selected.Name)</h2>
            <div class="list-toolbar">
                <form class="search" @onsubmit="() => LoadEntriesAsync(1)" @onsubmit:preventDefault>
                    <label class="visually-hidden" for="gtip-search">@Texts.Get("platform.gtip.search")</label>
                    <input id="gtip-search" class="form-control" type="search" placeholder="@Texts.Get("platform.gtip.searchPlaceholder")" @bind="search" />
                    <button type="submit" class="btn btn-outline-secondary">@Texts.Get("common.search")</button>
                </form>
                <button type="button" class="btn btn-ghost" @onclick="CloseEntries">@Texts.Get("common.close")</button>
            </div>
            @if (entries is null)
            {
                <LoadingState Kind="LoadingKind.Table" />
            }
            else if (entries.Items.Count == 0)
            {
                <EmptyState Compact="true" Title="@Texts.Get("platform.gtip.noMatch")" />
            }
            else
            {
                <table class="table record-table">
                    <caption class="visually-hidden">@Texts.Get("platform.gtip.entriesCaption")</caption>
                    <thead>
                        <tr>
                            <th scope="col"><SortHeader Label="@Texts.Get("warehouse.gtip")" ColumnIcon="hash" Asc="code" Desc="-code" Value="@entrySort" Default="code" ValueChanged="SortEntriesAsync" /></th>
                            <th scope="col"><SortHeader Label="@Texts.Get("platform.gtip.description")" ColumnIcon="type" Asc="description" Desc="-description" Value="@entrySort" Default="code" ValueChanged="SortEntriesAsync" /></th>
                            <th scope="col"><SortHeader Label="@Texts.Get("warehouse.unit")" ColumnIcon="tag" Asc="unit" Desc="-unit" Value="@entrySort" Default="code" ValueChanged="SortEntriesAsync" /></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in entries.Items)
                        {
                            <tr>
                                <td data-label="@Texts.Get("warehouse.gtip")" class="primary">@entry.Code</td>
                                <td data-label="@Texts.Get("platform.gtip.description")">@entry.Description</td>
                                <td data-label="@Texts.Get("warehouse.unit")">@(entry.Unit ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <Pager PageSizeChoice="true" Page="entries.Page" PageSize="entries.PageSize" TotalCount="entries.TotalCount" PageChanged="LoadEntriesAsync" />
            }
        </section>
    }
</PlatformGate>

@code {
    private List<GtipVersionDto>? versions;

    // Sürüm listesi tamamı yüklü gelir: istemcide sıralanır (ClientSort). Satırlar sayfalanır: sunucuda sıralanır (GtipEntrySort.Keys).
    private string versionSort = "";
    private string entrySort = "code";

    private static readonly Dictionary<string, Func<GtipVersionDto, object?>> VersionColumns = new()
    {
        ["name"] = v => v.Name,
        ["effectiveFrom"] = v => v.EffectiveFrom,
        ["entryCount"] = v => v.EntryCount,
        ["file"] = v => v.SourceFileName,
        ["createdAt"] = v => v.CreatedAt,
    };

    private void SortVersions(string value) => versionSort = value;

    private async Task SortEntriesAsync(string value)
    {
        entrySort = value;
        await LoadEntriesAsync(1);
    }
    private GtipVersionDto? selected;
    private GtipEntryPageDto? entries;
    private GtipImportPreviewDto? preview;
    private Guid? confirmDelete;
    private string? notice;
    private bool failed;
    private bool busy;
    private int inputKey;
    private string name = string.Empty;
    private DateTime? effectiveFrom;
    private string? search;
    private string? fileName;
    private byte[]? bytes;

    /// <summary>Bugün yürürlükte olan sürüm: yürürlük tarihi bugünü geçmemiş en yeni olan.</summary>
    private Guid? InForceId => versions?.Where(v => v.EffectiveFrom <= DateOnly.FromDateTime(DateTime.Today))
        .OrderByDescending(v => v.EffectiveFrom).Select(v => (Guid?)v.Id).FirstOrDefault();

    protected override async Task OnInitializedAsync() => await LoadVersionsAsync();

    private async Task LoadVersionsAsync()
    {
        var result = await Api.GetAsync<List<GtipVersionDto>>("/api/platform/gtip/versions");
        versions = result.Value;
        if (!result.IsSuccess)
        {
            Fail(result.Error);
        }
    }

    private async Task OnFileChosenAsync(InputFileChangeEventArgs e)
    {
        preview = null;
        bytes = null;
        notice = null;
        fileName = e.File.Name;
        try
        {
            using var stream = e.File.OpenReadStream(GtipImportLimits.MaxFileBytes);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            bytes = buffer.ToArray();
        }
        catch (IOException)
        {
            Fail(Texts.Get("platform.gtip.fileTooLarge", GtipImportLimits.MaxFileBytes / (1024 * 1024)));
            return;
        }

        // Dosya seçilir seçilmez önizlenir: hatalar daha ad ve tarih girilmeden görünür.
        await PreviewAsync();
    }

    private async Task PreviewAsync()
    {
        if (bytes is null || busy)
        {
            return;
        }

        busy = true;
        var result = await Api.PostBytesAsync<GtipImportPreviewDto>(
            $"/api/platform/gtip/versions/preview?fileName={Uri.EscapeDataString(fileName ?? string.Empty)}", bytes, "application/octet-stream");
        busy = false;
        preview = result.Value;
        if (!result.IsSuccess)
        {
            Fail(result.Error);
        }
    }

    private async Task ImportAsync()
    {
        if (busy || bytes is null || preview is not { CanImport: true })
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(name) || effectiveFrom is null)
        {
            Fail(Texts.Get("platform.gtip.nameAndDateRequired"));
            return;
        }

        busy = true;
        var day = DateOnly.FromDateTime(effectiveFrom.Value);
        var result = await Api.PostBytesAsync<GtipVersionDto>(
            $"/api/platform/gtip/versions?fileName={Uri.EscapeDataString(fileName ?? string.Empty)}&name={Uri.EscapeDataString(name.Trim())}&effectiveFrom={day:yyyy-MM-dd}",
            bytes, "application/octet-stream");
        busy = false;
        if (!result.IsSuccess)
        {
            Fail(result.Error);
            return;
        }

        notice = Texts.Get("platform.gtip.imported", result.Value!.Name, result.Value.EntryCount, result.Value.EffectiveFrom.ToString("dd.MM.yyyy"));
        failed = false;
        name = string.Empty;
        effectiveFrom = null;
        bytes = null;
        preview = null;
        fileName = null;
        inputKey++;
        await LoadVersionsAsync();
    }

    private async Task DeleteAsync(GtipVersionDto version)
    {
        busy = true;
        var result = await Api.DeleteAsync($"/api/platform/gtip/versions/{version.Id}");
        busy = false;
        confirmDelete = null;
        if (!result.IsSuccess)
        {
            Fail(result.Error);
            return;
        }

        notice = Texts.Get("platform.gtip.deleted", version.Name);
        failed = false;
        if (selected?.Id == version.Id)
        {
            CloseEntries();
        }

        await LoadVersionsAsync();
    }

    private async Task OpenEntriesAsync(GtipVersionDto version)
    {
        selected = version;
        search = null;
        entries = null;
        await LoadEntriesAsync(1);
    }

    private void CloseEntries()
    {
        selected = null;
        entries = null;
    }

    private async Task LoadEntriesAsync(int page)
    {
        if (selected is null)
        {
            return;
        }

        var result = await Api.GetAsync<GtipEntryPageDto>(
            $"/api/platform/gtip/versions/{selected.Id}/entries?page={page}&pageSize={ListPaging.Size}&search={Uri.EscapeDataString(search ?? string.Empty)}&sort={Uri.EscapeDataString(entrySort)}");
        entries = result.Value;
        if (!result.IsSuccess)
        {
            Fail(result.Error);
        }
    }

    private void Fail(string? message)
    {
        notice = message ?? Texts.Get("warehouse.regimeBindings.failed");
        failed = true;
    }
}
