@page "/platform/rejim-profilleri"
@using Modulix.Shared.Customs
@using Modulix.Shared.Sectors
@inject ApiClient Api

<PageTitle>@Texts.Get("nav.app.platform.regime-profiles") · @Texts.Get("nav.app.platform") · Modulix</PageTitle>

@* Rejim profili (ADR-0032 K16): ülke/rejim/antrepo tipine göre değişen kuralların sürümlü paketi. Bugün tescil numarası kuralını (K7) taşır: uzunluk, desen
   ve uygulama düzeyi. Akış: profil oluştur → taslak kaydet (doğrulanır, örnek numara kurala uymalı) → yayınla. Yayınlanan sürüm değişmez; yenisi yayınlanınca
   öncekinin yerini alır. Mevzuat doğrulanmadığı için yayın "Doğrulanmadı" olarak işaretli kalabilir; başlangıçta kural uyarıdır, engel değildir.
   Profil adları ve kodları, rejim kodu, desen ve doğrulama notu veridir, çevrilmez (ADR-0034 dilim 18). *@
<PlatformGate>
    <a class="back-link" href="platform">← @Texts.Get("nav.app.platform")</a>
    <h1>@Texts.Get("nav.app.platform.regime-profiles")</h1>
    <p class="text-muted">@Texts.Strong("platform.regimeProfiles.intro", Texts.Get("warehouse.regimeBindings.levelBlock"))</p>

    <Notice Text="@notice" Failed="@failed" />

    <form class="record-form settings-group" novalidate @onsubmit="CreateAsync" @onsubmit:preventDefault>
        <h2>@Texts.Get("platform.regimeProfiles.new")</h2>
        <div class="form-grid">
            <div>
                <label class="form-label" for="profile-code">@Texts.Get("platform.codeRequired")</label>
                <input id="profile-code" class="form-control" maxlength="50" placeholder="@Texts.Get("platform.regimeProfiles.codePlaceholder")" @bind="newCode" @bind:event="oninput" />
                <div class="form-text">@Texts.Get("platform.codeHint")</div>
            </div>
            <div>
                <label class="form-label" for="profile-name">@Texts.Get("common.field.nameRequired")</label>
                <input id="profile-name" class="form-control" maxlength="100" placeholder="@Texts.Get("platform.regimeProfiles.namePlaceholder")" @bind="newName" @bind:event="oninput" />
            </div>
        </div>
        <div class="form-actions">
            <button type="submit" class="btn btn-outline-secondary" disabled="@busy">@Texts.Get("platform.regimeProfiles.create")</button>
        </div>
    </form>

    <h2 class="mt-4">@Texts.Get("platform.regimeProfiles.profiles")</h2>
    @if (profiles is null)
    {
        <LoadingState Kind="LoadingKind.Table" />
    }
    else if (profiles.Count == 0)
    {
        <p class="text-muted" role="status">@Texts.Get("platform.regimeProfiles.empty")</p>
    }
    else
    {
        <table class="table record-table">
            <caption class="visually-hidden">@Texts.Get("nav.app.platform.regime-profiles")</caption>
            <thead>
                <tr><th scope="col">@Texts.Get("platform.tenantDetail.profileLabel")</th><th scope="col">@Texts.Get("warehouse.code")</th><th scope="col">@Texts.Get("platform.regimeProfiles.col.published")</th><th scope="col">@Texts.Get("platform.regimeProfiles.draft")</th><th scope="col">@Texts.Get("common.field.status")</th><th scope="col"></th></tr>
            </thead>
            <tbody>
                @foreach (var profile in profiles)
                {
                    <tr>
                        <td data-label="@Texts.Get("platform.tenantDetail.profileLabel")" class="primary">@profile.Name</td>
                        <td data-label="@Texts.Get("warehouse.code")">@profile.Code</td>
                        <td data-label="@Texts.Get("platform.regimeProfiles.col.published")">
                            @if (profile.PublishedNumber is { } number)
                            {
                                <span>@Texts.Get("platform.regimeProfiles.versionNumber", number)</span>
                                <span class="badge @(profile.PublishedVerified ? "status-customer" : "stage-qualified")">@(profile.PublishedVerified ? Texts.Get("warehouse.verified") : Texts.Get("warehouse.unverified"))</span>
                            }
                            else
                            {
                                <span class="text-muted">@Texts.Get("platform.regimeProfiles.notPublished")</span>
                            }
                        </td>
                        <td data-label="@Texts.Get("platform.regimeProfiles.draft")">@(profile.HasDraft ? Texts.Get("platform.regimeProfiles.hasDraft") : "—")</td>
                        <td data-label="@Texts.Get("common.field.status")"><span class="badge @WarehouseLabels.ActiveBadge(profile.IsActive)">@WarehouseLabels.ActiveText(profile.IsActive)</span></td>
                        <td class="actions"><button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => OpenAsync(profile.Id)">@Texts.Get("common.open")</button></td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (detail is not null)
    {
        <section class="record-form settings-group" aria-label="@Texts.Get("platform.regimeProfiles.detail")">
            <h2>@detail.Summary.Name <small class="text-muted">· @detail.Summary.Code</small></h2>

            <form novalidate @onsubmit="SaveDraftAsync" @onsubmit:preventDefault>
                <h3>@(detail.Summary.HasDraft ? Texts.Get("platform.regimeProfiles.draft") : Texts.Get("platform.regimeProfiles.newDraft"))</h3>
                <div class="form-grid">
                    <div>
                        <label class="form-label" for="rule-regime">@Texts.Get("platform.regimeProfiles.regimeCode")</label>
                        <input id="rule-regime" class="form-control" maxlength="20" placeholder="@Texts.Get("platform.regimeProfiles.example", "7100")" @bind="draft.RegimeCode" />
                    </div>
                    <div>
                        <label class="form-label" for="rule-min">@Texts.Get("platform.regimeProfiles.minLength")</label>
                        <input id="rule-min" class="form-control" type="number" min="1" max="30" @bind="draft.MinLength" />
                    </div>
                    <div>
                        <label class="form-label" for="rule-max">@Texts.Get("platform.regimeProfiles.maxLength")</label>
                        <input id="rule-max" class="form-control" type="number" min="1" max="30" @bind="draft.MaxLength" />
                    </div>
                    <div>
                        <label class="form-label" for="rule-pattern">@Texts.Get("platform.regimeProfiles.pattern")</label>
                        <input id="rule-pattern" class="form-control" maxlength="200" placeholder="@Texts.Get("platform.regimeProfiles.example", PatternExample)" @bind="draft.Pattern" />
                        <div class="form-text">@Texts.Get("platform.regimeProfiles.patternHint")</div>
                    </div>
                    <div>
                        <label class="form-label" for="rule-example">@Texts.Get("platform.regimeProfiles.validExample")</label>
                        <input id="rule-example" class="form-control" maxlength="30" @bind="draft.Example" />
                        <div class="form-text">@Texts.Get("platform.regimeProfiles.validExampleHint")</div>
                    </div>
                    <div>
                        <label class="form-label" for="rule-level">@Texts.Get("warehouse.regimeBindings.onViolation")</label>
                        <select id="rule-level" class="form-select" @bind="draft.Enforcement">
                            @foreach (var (key, label) in PlatformLabels.Enforcements)
                            {
                                <option value="@key">@label</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-outline-secondary" disabled="@busy">@Texts.Get("admin.automationEditor.saveDraft")</button>
                    @if (detail.Summary.HasDraft)
                    {
                        <button type="button" class="btn btn-outline-danger" disabled="@busy" @onclick="DiscardDraftAsync">@Texts.Get("platform.regimeProfiles.discardDraft")</button>
                    }
                </div>
            </form>

            @if (detail.Summary.HasDraft)
            {
                <form class="mt-3" novalidate @onsubmit="PublishAsync" @onsubmit:preventDefault>
                    <h3>@Texts.Get("platform.regimeProfiles.publish")</h3>
                    <div class="form-grid">
                        <div>
                            <label class="form-label" for="publish-verified">@Texts.Get("platform.regimeProfiles.verification")</label>
                            <select id="publish-verified" class="form-select" @bind="verified">
                                <option value="False">@Texts.Get("platform.regimeProfiles.unverifiedOption")</option>
                                <option value="True">@Texts.Get("warehouse.verified")</option>
                            </select>
                        </div>
                        <div>
                            <label class="form-label" for="publish-note">@(verified ? Texts.Get("platform.regimeProfiles.noteRequired") : Texts.Get("platform.regimeProfiles.note"))</label>
                            <input id="publish-note" class="form-control" maxlength="500" placeholder="@Texts.Get("platform.regimeProfiles.notePlaceholder")" @bind="note" />
                        </div>
                    </div>
                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary" disabled="@busy">@Texts.Get("platform.regimeProfiles.publish")</button>
                    </div>
                </form>
            }

            <h3 class="mt-3">@Texts.Get("platform.versions")</h3>
            @if (detail.Versions.Count == 0)
            {
                <EmptyState Title="@Texts.Get("platform.regimeProfiles.noVersions")" />
            }
            else
            {
                <table class="table record-table">
                    <caption class="visually-hidden">@Texts.Get("platform.regimeProfiles.versionsCaption")</caption>
                    <thead><tr><th scope="col">@Texts.Get("platform.health.version")</th><th scope="col">@Texts.Get("common.field.status")</th><th scope="col">@Texts.Get("platform.regimeProfiles.verification")</th><th scope="col">@Texts.Get("warehouse.regimeBindings.rule")</th><th scope="col">@Texts.Get("platform.regimeProfiles.col.published")</th></tr></thead>
                    <tbody>
                        @foreach (var version in detail.Versions)
                        {
                            <tr>
                                <td data-label="@Texts.Get("platform.health.version")" class="primary">@version.Number</td>
                                <td data-label="@Texts.Get("common.field.status")"><span class="badge @StateBadge(version.State)">@PlatformLabels.RegimeStateOf(version.State)</span></td>
                                <td data-label="@Texts.Get("platform.regimeProfiles.verification")">@(version.State == "Draft" ? "—" : version.IsVerified ? Texts.Get("platform.regimeProfiles.verifiedWithNote", version.VerificationNote) : Texts.Get("warehouse.unverified"))</td>
                                <td data-label="@Texts.Get("warehouse.regimeBindings.rule")">@RuleText(version.Content.RegistrationNo)</td>
                                <td data-label="@Texts.Get("platform.regimeProfiles.col.published")">@(version.PublishedAt is { } at ? CrmLabels.Time(at) : "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            <div class="form-actions">
                <button type="button" class="btn btn-outline-secondary" disabled="@busy" @onclick="ToggleActiveAsync">@(detail.Summary.IsActive ? Texts.Get("admin.subProfiles.deactivate") : Texts.Get("admin.subProfiles.activate"))</button>
                <button type="button" class="btn btn-ghost" @onclick="Close">@Texts.Get("common.close")</button>
            </div>
        </section>
    }
</PlatformGate>

@code {
    private const string Url = "/api/platform/regime-profiles";

    // Desen örneği düzenli ifadedir, dile göre değişmez; yalnızca "ör." öneki sözlükten gelir.
    private const string PatternExample = @"\d{8}[A-Z]{2}\d{8}";

    private List<RegimeProfileSummaryDto>? profiles;
    private RegimeProfileDetailDto? detail;
    private DraftForm draft = new();
    private string? notice;
    private bool failed;
    private bool busy;
    private string newCode = string.Empty;
    private string newName = string.Empty;
    private bool verified;
    private string? note;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var result = await Api.GetAsync<List<RegimeProfileSummaryDto>>(Url);
        profiles = result.Value;
        if (!result.IsSuccess)
        {
            Fail(result.Error);
        }
    }

    private async Task CreateAsync()
    {
        if (busy)
        {
            return;
        }

        busy = true;
        var result = await Api.PostAsync<RegimeProfileSummaryDto>(Url, new CreateRegimeProfileRequest(newCode.Trim(), newName.Trim()));
        busy = false;
        if (!result.IsSuccess)
        {
            Fail(result.Error);
            return;
        }

        Succeed(Texts.Get("platform.regimeProfiles.created", result.Value!.Name));
        newCode = newName = string.Empty;
        await LoadAsync();
        await OpenAsync(result.Value.Id);
    }

    private async Task OpenAsync(Guid id)
    {
        var result = await Api.GetAsync<RegimeProfileDetailDto>($"{Url}/{id}");
        if (!result.IsSuccess)
        {
            Fail(result.Error);
            return;
        }

        detail = result.Value;
        verified = false;
        note = null;

        // Taslak varsa taslak, yoksa yayındaki sürüm düzenleme başlangıcıdır; hiçbiri yoksa boş kural.
        var source = detail!.Versions.FirstOrDefault(v => v.State == "Draft") ?? detail.Versions.FirstOrDefault(v => v.State == "Published");
        draft = DraftForm.From(source?.Content);
    }

    private void Close() => detail = null;

    private async Task SaveDraftAsync()
    {
        if (busy || detail is null)
        {
            return;
        }

        busy = true;
        var result = await Api.PutAsync<RegimeProfileVersionDto>($"{Url}/{detail.Summary.Id}/draft", draft.ToDto());
        busy = false;
        if (!result.IsSuccess)
        {
            Fail(result.Error);
            return;
        }

        Succeed(Texts.Get("platform.regimeProfiles.draftSaved", result.Value!.Number));
        await LoadAsync();
        await OpenAsync(detail.Summary.Id);
    }

    private async Task DiscardDraftAsync()
    {
        if (busy || detail is null)
        {
            return;
        }

        busy = true;
        var result = await Api.DeleteAsync($"{Url}/{detail.Summary.Id}/draft");
        busy = false;
        if (!result.IsSuccess)
        {
            Fail(result.Error);
            return;
        }

        Succeed(Texts.Get("platform.regimeProfiles.draftDiscarded"));
        await LoadAsync();
        await OpenAsync(detail.Summary.Id);
    }

    private async Task PublishAsync()
    {
        if (busy || detail is null)
        {
            return;
        }

        busy = true;
        var result = await Api.PostAsync<RegimeProfileVersionDto>($"{Url}/{detail.Summary.Id}/publish", new PublishRegimeProfileRequest(verified, note));
        busy = false;
        if (!result.IsSuccess)
        {
            Fail(result.Error);
            return;
        }

        Succeed(result.Value!.IsVerified
            ? Texts.Get("platform.regimeProfiles.publishedVerified", result.Value.Number)
            : Texts.Get("platform.regimeProfiles.publishedUnverified", result.Value.Number));
        await LoadAsync();
        await OpenAsync(detail.Summary.Id);
    }

    private async Task ToggleActiveAsync()
    {
        if (busy || detail is null)
        {
            return;
        }

        busy = true;
        var result = await Api.PutAsync<RegimeProfileSummaryDto>($"{Url}/{detail.Summary.Id}/active", new SetActiveRequest(!detail.Summary.IsActive));
        busy = false;
        if (!result.IsSuccess)
        {
            Fail(result.Error);
            return;
        }

        Succeed(result.Value!.IsActive ? Texts.Get("platform.regimeProfiles.activated") : Texts.Get("platform.regimeProfiles.deactivated"));
        await LoadAsync();
        await OpenAsync(detail.Summary.Id);
    }

    private static string StateBadge(string state) => state switch
    {
        "Published" => "status-customer",
        "Draft" => "stage-qualified",
        _ => "status-inactive",
    };

    private static string RuleText(RegistrationNoRuleDto? rule)
    {
        if (rule is null)
        {
            return Texts.Get("warehouse.regimeBindings.noRule");
        }

        var parts = new List<string>();
        if (rule.MinLength is not null || rule.MaxLength is not null)
        {
            parts.Add(Texts.Get("warehouse.regimeBindings.length", rule.MinLength?.ToString() ?? "—", rule.MaxLength?.ToString() ?? "—"));
        }

        if (!string.IsNullOrEmpty(rule.Pattern))
        {
            parts.Add(Texts.Get("warehouse.regimeBindings.pattern", rule.Pattern));
        }

        parts.Add(rule.Enforcement == "Block" ? Texts.Get("platform.regimeProfiles.ruleBlock") : Texts.Get("platform.regimeProfiles.ruleWarn"));
        return string.Join(" · ", parts);
    }

    private void Succeed(string message)
    {
        notice = message;
        failed = false;
    }

    private void Fail(string? message)
    {
        notice = message ?? Texts.Get("warehouse.regimeBindings.failed");
        failed = true;
    }

    private sealed class DraftForm
    {
        public string? RegimeCode { get; set; }

        public int? MinLength { get; set; }

        public int? MaxLength { get; set; }

        public string? Pattern { get; set; }

        public string? Example { get; set; }

        public string Enforcement { get; set; } = "Warn";

        public static DraftForm From(RegimeProfileContentDto? content) => new()
        {
            RegimeCode = content?.RegimeCode,
            MinLength = content?.RegistrationNo?.MinLength,
            MaxLength = content?.RegistrationNo?.MaxLength,
            Pattern = content?.RegistrationNo?.Pattern,
            Example = content?.RegistrationNo?.Example,
            Enforcement = content?.RegistrationNo?.Enforcement ?? "Warn",
        };

        /// <summary>Kural alanlarının hepsi boşsa kural bölümü gönderilmez (kural yok); boş metinler null olur.</summary>
        public RegimeProfileContentDto ToDto()
        {
            static string? Clean(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
            var hasRule = MinLength is not null || MaxLength is not null || Clean(Pattern) is not null || Clean(Example) is not null;
            return new RegimeProfileContentDto(1, Clean(RegimeCode), hasRule
                ? new RegistrationNoRuleDto(Clean(Pattern), MinLength, MaxLength, Clean(Example), Enforcement)
                : null);
        }
    }
}
