@page "/teklif/{Tenant}"
@layout PublicLayout
@inject ApiClient Api
@inject NavigationManager Navigation
@inject IJSRuntime Js

<PageTitle>@(view?.Content is { } c ? Texts.Get("crm.public-quote.title-number", c.QuoteNumber) : Texts.Get("crm.public-quote.title")) · Modulix</PageTitle>

@* Oturumsuz müşteri sayfası (ADR-0019). Belirteç adresin # parçasındadır (#t=...): sunucuya, günlüklere ve Referer başlığına gitmez;
   API çağrılarında gövdede taşınır. Gösterilen her şey belgenin sabitlenmiş verisidir. *@

@if (loading)
{
    <LoadingState />
}
else if (invalid)
{
    <div class="alert alert-warning" role="alert">
        <h1 class="h5">@Texts.Get("crm.public-quote.invalid")</h1>
        <p class="mb-0">@(problem ?? Texts.Get("crm.public-quote.invalid-text"))</p>
    </div>
}
else if (view is not null)
{
    <article class="public-quote" aria-labelledby="pq-title">
        @if (view.State != "open")
        {
            <div class="alert @(view.State == "accepted" ? "alert-success" : "alert-warning")" role="status" id="pq-state">
                <strong>@StateTitle(view.State)</strong>
                <div>@view.Message</div>
                @if (view.Decision is { } decided)
                {
                    <div class="small">@decided.SignerName · @CrmLabels.Time(decided.At)</div>
                }
            </div>
        }

        @if (view.Content is { } content)
        {
            <header class="public-quote-header">
                <div>
                    <p class="public-seller">@content.Seller.Name</p>
                    @if (content.Seller.Details is { Length: > 0 } details)
                    {
                        <p class="text-muted small">@details</p>
                    }
                </div>
                <dl class="summary-list">
                    <div><dt>@Texts.Get("crm.public-quote.number")</dt><dd>@content.QuoteNumber · V@(content.RevisionNo)</dd></div>
                    <div><dt>@Texts.Get("crm.public-quote.date")</dt><dd>@CrmLabels.Date(content.IssueDate)</dd></div>
                    @if (content.ValidUntil is { } until)
                    {
                        <div><dt>@Texts.Get("crm.public-quote.valid-until")</dt><dd>@CrmLabels.Time(until)</dd></div>
                    }
                </dl>
            </header>

            <h1 id="pq-title" class="h4">@content.Title</h1>
            <p class="text-muted">
                @content.CustomerName@if (content.CustomerCity is not null) { <text> · @content.CustomerCity</text> }
                @if (content.ContactName is { Length: > 0 }) { <text><br />@Texts.Get("crm.public-quote.contact", content.ContactName)</text> }
            </p>
            @if (!string.IsNullOrWhiteSpace(content.Description))
            {
                <p>@content.Description</p>
            }

            <table class="table record-table">
                <caption class="visually-hidden">@Texts.Get("crm.public-quote.lines")</caption>
                <thead>
                    <tr>
                        <th scope="col">@Texts.Get("crm.public-quote.col.item")</th><th scope="col" class="text-end">@Texts.Get("crm.public-quote.col.quantity")</th><th scope="col" class="text-end">@Texts.Get("crm.public-quote.col.unit-price")</th>
                        <th scope="col" class="text-end">@Texts.Get("crm.public-quote.col.discount")</th><th scope="col" class="text-end">@Texts.Get("crm.public-quote.col.vat")</th><th scope="col" class="text-end">@Texts.Get("crm.public-quote.col.net")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in content.Lines)
                    {
                        <tr>
                            <td data-label="@Texts.Get("crm.public-quote.col.item")" class="primary">
                                @line.Name
                                @if (line.Code is not null) { <small class="text-muted"> (@line.Code)</small> }
                                @if (RoleNote(line) is { } note) { <div class="small text-muted">@note</div> }
                                @if (!string.IsNullOrWhiteSpace(line.Description)) { <div class="small text-muted">@line.Description</div> }
                            </td>
                            <td data-label="@Texts.Get("crm.public-quote.col.quantity")" class="text-end">@line.Quantity.ToString("0.####", Regional.Numbers)@(line.Unit is null ? null : $" {line.Unit}")</td>
                            <td data-label="@Texts.Get("crm.public-quote.col.unit-price")" class="text-end">@line.UnitPrice.ToString("N2", Regional.Numbers)</td>
                            <td data-label="@Texts.Get("crm.public-quote.col.discount")" class="text-end">@Discount(line)</td>
                            <td data-label="@Texts.Get("crm.public-quote.col.vat")" class="text-end">%@line.TaxRatePercent.ToString("0.##", Regional.Numbers)</td>
                            <td data-label="@Texts.Get("crm.public-quote.col.net")" class="text-end">@(line.Included ? line.Net.ToString("N2", Regional.Numbers) : "—")</td>
                        </tr>
                    }
                </tbody>
            </table>

            <dl class="summary-list public-totals">
                <div><dt>@Texts.Get("crm.public-quote.list-total")</dt><dd>@QuoteLabels.Money(content.ListTotal, content.Currency)</dd></div>
                @if (content.DiscountTotal > 0)
                {
                    <div><dt>@Texts.Get("crm.public-quote.discount-total")</dt><dd>-@QuoteLabels.Money(content.DiscountTotal, content.Currency)</dd></div>
                }
                <div><dt>@Texts.Get("crm.public-quote.net-total")</dt><dd>@QuoteLabels.Money(content.NetTotal, content.Currency)</dd></div>
                @foreach (var tax in content.TaxGroups)
                {
                    <div><dt>@Texts.Get("crm.public-quote.vat-rate", tax.RatePercent.ToString("0.##", Regional.Numbers))</dt><dd>@QuoteLabels.Money(tax.Tax, content.Currency)</dd></div>
                }
                <div class="total"><dt>@Texts.Get("crm.public-quote.gross-total")</dt><dd>@QuoteLabels.Money(content.GrossTotal, content.Currency)</dd></div>
            </dl>
            @if (content.OptionalNet > 0)
            {
                <p class="small text-muted">@Texts.Get("crm.public-quote.optional-note", QuoteLabels.Money(content.OptionalNet, content.Currency))</p>
            }

            @foreach (var (label, text) in Terms(content))
            {
                <section>
                    <h2 class="h6">@label</h2>
                    <p class="preline">@text</p>
                </section>
            }

            <p>
                <button type="button" class="btn btn-outline-primary" disabled="@busy" @onclick="DownloadAsync">@Texts.Get("crm.public-quote.download")</button>
                <span class="small text-muted">@Texts.Get("crm.public-quote.digest") <code>@view.DocumentSha256[..16]…</code></span>
            </p>
        }

        @if (view.CanDecide)
        {
            <section aria-labelledby="pq-decision" class="public-decision">
                <h2 id="pq-decision" class="h5">@Texts.Get("crm.public-quote.decision")</h2>
                <Notice Text="@message" Failed="true" />

                <div class="form-grid">
                    <div>
                        <label class="form-label" for="pq-name">@Texts.Get("crm.public-quote.signer-name") *</label>
                        <input id="pq-name" class="form-control" autocomplete="name" maxlength="200" @bind="signerName" />
                        <FieldError Errors="@errors" Field="signerName" />
                    </div>
                    <div>
                        <label class="form-label" for="pq-title-input">@Texts.Get("crm.public-quote.signer-title")</label>
                        <input id="pq-title-input" class="form-control" autocomplete="organization-title" maxlength="200" @bind="signerTitle" />
                        <FieldError Errors="@errors" Field="signerTitle" />
                    </div>
                    <div>
                        <label class="form-label" for="pq-email">@Texts.Get("common.field.email")</label>
                        <input id="pq-email" class="form-control" type="email" autocomplete="email" maxlength="254" @bind="signerEmail" />
                        <FieldError Errors="@errors" Field="signerEmail" />
                    </div>
                </div>

                @if (mode is null)
                {
                    <div class="form-actions">
                        <button type="button" class="btn btn-primary" @onclick='() => mode = "accept"'>@Texts.Get("crm.public-quote.accept")</button>
                        <button type="button" class="btn btn-outline-secondary" @onclick='() => mode = "reject"'>@Texts.Get("crm.public-quote.reject")</button>
                    </div>
                }
                else if (mode == "accept")
                {
                    <form novalidate @onsubmit="() => DecideAsync(true)" @onsubmit:preventDefault>
                        <div class="form-check">
                            <input id="pq-confirm" class="form-check-input" type="checkbox" @bind="confirm" aria-describedby="pq-statement" />
                            <label class="form-check-label" for="pq-confirm" id="pq-statement">@view.AcceptanceStatement</label>
                        </div>
                        <FieldError Errors="@errors" Field="confirmTerms" />
                        <FieldError Errors="@errors" Field="documentSha256" />
                        <div class="form-actions">
                            <button type="submit" class="btn btn-primary" disabled="@busy">@Texts.Get("crm.public-quote.confirm-accept")</button>
                            <IconAction Icon="x" Label="@Texts.Get("common.cancel")" OnClick="() => mode = null" />
                        </div>
                    </form>
                }
                else
                {
                    <form novalidate @onsubmit="() => DecideAsync(false)" @onsubmit:preventDefault>
                        <label class="form-label" for="pq-reason">@Texts.Get("crm.public-quote.reason") *</label>
                        <textarea id="pq-reason" class="form-control" rows="3" maxlength="500" @bind="reason"></textarea>
                        <FieldError Errors="@errors" Field="reason" />
                        <div class="form-actions">
                            <button type="submit" class="btn btn-outline-danger" disabled="@busy">@Texts.Get("crm.public-quote.confirm-reject")</button>
                            <IconAction Icon="x" Label="@Texts.Get("common.cancel")" OnClick="() => mode = null" />
                        </div>
                    </form>
                }
            </section>
        }
    </article>
}

@code {
    [Parameter] public string Tenant { get; set; } = string.Empty;

    private PublicQuoteView? view;
    private IReadOnlyDictionary<string, string[]>? errors;
    private string token = string.Empty;
    private string? problem;
    private string? message;
    private string? mode;
    private string signerName = string.Empty;
    private string signerTitle = string.Empty;
    private string signerEmail = string.Empty;
    private string reason = string.Empty;
    private bool confirm;
    private bool loading = true;
    private bool invalid;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        // Sayfa önce tarayıcının diliyle açılır; teklif gelince müşterinin diline geçer (ADR-0034 §6).
        await PublicTexts.ApplyAsync(Api, null);
        token = TokenFromFragment(Navigation.Uri);
        if (token.Length == 0)
        {
            loading = false;
            invalid = true;
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var result = await Api.PostAsync<PublicQuoteView>($"/api/public/quotes/{Uri.EscapeDataString(Tenant)}/view", new PublicQuoteTokenRequest(token));
        if (result.Value is { } loaded)
        {
            await PublicTexts.ApplyAsync(Api, loaded.Language);
            view = loaded;
            loading = false;
            invalid = false;
            return;
        }

        loading = false;
        invalid = true;
        problem = result.Status == System.Net.HttpStatusCode.NotFound ? null : result.Error;
    }

    private async Task DecideAsync(bool accept)
    {
        if (busy || view is null) { return; }
        busy = true;
        errors = null;
        message = null;
        var result = await Api.PostAsync<PublicQuoteView>($"/api/public/quotes/{Uri.EscapeDataString(Tenant)}/decision", new PublicQuoteDecisionRequest(
            token, accept ? "accept" : "reject", signerName, Blank(signerEmail), Blank(signerTitle), accept ? null : Blank(reason), accept && confirm, view.DocumentSha256));
        busy = false;
        if (result.Value is { } updated)
        {
            view = updated;
            mode = null;
            return;
        }

        errors = result.FieldErrors;
        message = result.Error;
        if (result.Status == System.Net.HttpStatusCode.Conflict)
        {
            // Durum değişmiştir (başka karar, iptal, süre): güncel halini göster.
            await LoadAsync();
        }
    }

    private async Task DownloadAsync()
    {
        if (busy || view is null) { return; }
        busy = true;
        var result = await Api.PostForFileAsync($"/api/public/quotes/{Uri.EscapeDataString(Tenant)}/pdf", new PublicQuoteTokenRequest(token));
        busy = false;
        if (result.Value is { } bytes)
        {
            await Js.InvokeVoidAsync("modulixDownload", $"{view.QuoteNumber}-V{view.RevisionNo}.pdf", "application/pdf", Convert.ToBase64String(bytes));
        }
        else
        {
            message = result.Error;
        }
    }

    /// <summary>Belirteç adresin # parçasından okunur (#t=...); parça sunucuya gönderilmez.</summary>
    internal static string TokenFromFragment(string uri)
    {
        var index = uri.IndexOf('#');
        if (index < 0)
        {
            return string.Empty;
        }

        foreach (var part in uri[(index + 1)..].Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            if (part.StartsWith("t=", StringComparison.Ordinal))
            {
                return Uri.UnescapeDataString(part[2..]);
            }
        }

        return string.Empty;
    }

    private static string StateTitle(string state) => state switch
    {
        "accepted" => Texts.Get("crm.public-quote.state.accepted"),
        "rejected" => Texts.Get("crm.public-quote.state.rejected"),
        "expired" => Texts.Get("crm.public-quote.state.expired"),
        "superseded" => Texts.Get("crm.public-quote.state.superseded"),
        "cancelled" => Texts.Get("crm.public-quote.state.cancelled"),
        "link-expired" => Texts.Get("crm.public-quote.state.link-expired"),
        "link-revoked" => Texts.Get("crm.public-quote.state.link-revoked"),
        _ => Texts.Get("crm.public-quote.title"),
    };

    private static string? RoleNote(PublicQuoteLine line) => line.Role switch
    {
        "Optional" => Texts.Get(line.IsSelected ? "crm.public-quote.role.optional-selected" : "crm.public-quote.role.optional"),
        "Alternative" => Texts.Get(line.IsSelected ? "crm.public-quote.role.alternative-selected" : "crm.public-quote.role.alternative"),
        "PackageChild" => Texts.Get("crm.public-quote.role.package-child"),
        _ => null,
    };

    private static string Discount(PublicQuoteLine line) => line.DiscountKind switch
    {
        "Percent" when line.DiscountValue > 0 => $"%{line.DiscountValue.ToString("0.##", Regional.Numbers)}",
        "Amount" when line.DiscountValue > 0 => line.DiscountValue.ToString("N2", Regional.Numbers),
        _ => "—",
    };

    private static IEnumerable<(string Label, string Text)> Terms(PublicQuoteContent content)
    {
        if (!string.IsNullOrWhiteSpace(content.PaymentTerms)) { yield return (Texts.Get("crm.public-quote.payment-terms"), content.PaymentTerms); }
        if (!string.IsNullOrWhiteSpace(content.DeliveryTerms)) { yield return (Texts.Get("crm.public-quote.delivery-terms"), content.DeliveryTerms); }
        if (!string.IsNullOrWhiteSpace(content.CommercialTerms)) { yield return (Texts.Get("crm.public-quote.commercial-terms"), content.CommercialTerms); }
    }

    private static string? Blank(string? text) => string.IsNullOrWhiteSpace(text) ? null : text.Trim();
}
