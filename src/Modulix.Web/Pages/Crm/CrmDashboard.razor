@page "/crm/pano"
@using System.Globalization
@using System.Net
@inject ApiClient Api
@inject SessionState Session
@inject CrmLookups Lookups
@inject NavigationManager Nav

<PageTitle>@Texts.Get("crm.dashboard.title") · Modulix</PageTitle>

@* İki sekme (ViewTabs): Hedef merkezi ve Benim günüm (MyDayPanel). Hedef merkezi: veri Satış görünümüyle aynı uçtan gelir, yeni hesap yoktur. Kapsam ve tutar izni sunucuda uygulanır; tutar izni yoksa adetler gösterilir. *@
@* Satış raporu izni olmayan temsilci yalnızca Benim günüm'ü görür (sekme çubuğu çizilmez). *@
<AuthGate Module="@CrmAccess.ModuleKey" AnyPermission="SalesAccess.MyDayAny">
    <div class="page-header">
        <div>
            <h1>@Texts.Get("crm.dashboard.title")</h1>
            <p class="page-subtitle">@(view == DayView ? Greeting : Subtitle)</p>
        </div>
        <div class="header-actions">
            @if (view == DayView)
            {
                @if (Session.Can(CrmAccess.ActivitiesRead))
                {
                    <a class="btn btn-outline-secondary" href="crm/aktiviteler"><AppIcon Name="calendar" Size="16" /> @Texts.Get("crm.dashboard.calendar")</a>
                }
                @if (Session.Can(CrmAccess.ActivitiesWrite))
                {
                    <button type="button" class="btn btn-primary" @onclick="() => myDay?.NewActivity()"><AppIcon Name="plus" Size="16" /> @Texts.Get("crm.activities.new")</button>
                }
            }
            else
            {
            <div class="segmented" role="group" aria-label="@Texts.Get("crm.sales.periodKind")">
                @foreach (var (key, label) in SalesLabels.PeriodKinds)
                {
                    <button type="button" class="chip @(kind == key ? "active" : null)" aria-pressed="@(kind == key ? "true" : "false")" disabled="@loading" @onclick="() => ChooseKindAsync(key)">@label</button>
                }
            </div>
            <select class="form-select dash-filter" aria-label="@Texts.Get("common.field.owner")" @bind="owner" @bind:after="LoadAsync">
                <option value="">@Texts.Get("crm.dashboard.all-team")</option>
                @foreach (var member in Lookups.Members)
                {
                    <option value="@member.UserId">@member.DisplayName</option>
                }
            </select>
            @if (Session.Can(CrmAccess.OpportunitiesWrite))
            {
                <a class="btn btn-primary" href="crm/firsatlar?yeni=true"><AppIcon Name="plus" Size="16" /> @Texts.Get("crm.opportunities.new")</a>
            }
            }
        </div>
    </div>

    @if (CanReports)
    {
        <ViewTabs Items="Views" Value="@view" ValueChanged="ChooseViewAsync" Label="@Texts.Get("crm.dashboard.views")" />
    }

    @if (view == DayView)
    {
        <MyDayPanel @ref="myDay" Lookups="Lookups" SummaryChanged="s => summary = s" />
    }
    else
    {

    @if (loading && report is null)
    {
        <LoadingState />
    }

    @if (error is not null)
    {
        <div class="alert @(forbidden ? "alert-warning" : "alert-danger")" role="alert">
            @(forbidden ? Texts.Get("crm.dashboard.forbidden") + " " : null)@error
            @if (!forbidden)
            {
                <button type="button" class="btn btn-outline-secondary btn-sm ms-2" disabled="@loading" @onclick="LoadAsync">@Texts.Get("crm.sales.retry")</button>
            }
        </div>
    }

    @if (report is not null)
    {
        var r = report;
        var amounts = r.AmountsVisible;
        var progress = (amounts ? r.AmountTarget : r.CountTarget)?.Progress;
        var tempo = SalesLabels.PeriodElapsedPercent(r.PeriodStart, r.PeriodEnd, r.Today);

        <section class="dash-hero @(progress is null ? "dash-hero-solo" : null)" aria-label="@Texts.Get("crm.dashboard.outlook")">
            <div>
                <p class="dash-hero-kicker">@(amounts ? Texts.Get("crm.dashboard.outlook-kicker") : Texts.Get("crm.dashboard.won"))</p>
                <div class="dash-hero-headline">
                    <span class="dash-hero-value">@(amounts ? SalesLabels.Compact(r.Outlook, r.Currency) : SalesLabels.Count(r.WonCount))</span>
                    @if (progress is not null)
                    {
                        <span class="dash-hero-note">@Texts.Get("crm.dashboard.target-line", Figure(progress.Target, r), SalesLabels.Percent(Math.Round(Share(amounts ? r.Outlook : progress.Realized, progress))))</span>
                    }
                    else if (Session.Can(SalesAccess.TargetsRead))
                    {
                        <span class="dash-hero-note">@Texts.Get("crm.dashboard.no-target") <a href="crm/satis-hedefleri">@Texts.Get("crm.dashboard.define-target")</a></span>
                    }
                </div>
                @if (progress is not null)
                {
                    <GoalMeter Realized="Share(progress.Realized, progress)" Weighted="@(amounts ? Share(r.WeightedOpen.Amount, progress) : 0m)" Tempo="tempo" Label="@MeterLabel(r, progress, tempo)" />
                }
                <div class="dash-hero-legend">
                    @if (amounts)
                    {
                        <span><i class="fill-realized"></i>@Texts.Get("crm.sales-card.realized") @SalesLabels.Compact(r.Realized.Amount, r.Currency)</span>
                        <span><i class="fill-weighted"></i>@Texts.Get("crm.sales-card.weightedopen") @SalesLabels.Compact(r.WeightedOpen.Amount, r.Currency)</span>
                    }
                    @if (progress is not null && tempo is { } elapsed)
                    {
                        <span><i class="fill-tempo"></i>@Texts.Get("crm.dashboard.today-tempo") @SalesLabels.Percent(Math.Round(elapsed))</span>
                    }
                </div>
            </div>
            @if (progress is not null)
            {
                <dl class="dash-hero-stats">
                    <div>
                        <dd>@(progress.TargetMet ? Texts.Get("crm.dashboard.target-met") : Figure(progress.Remaining, r))</dd>
                        <dt>@Texts.Get("crm.dashboard.remaining")</dt>
                    </div>
                    <div>
                        <dd>@(progress.Coverage is { } coverage ? $"{coverage.ToString("0.0", Regional.Numbers)}×" : "—")</dd>
                        <dt>@Texts.Get("crm.salesTarget.coverage")</dt>
                    </div>
                    @if (tempo is { } pace)
                    {
                        var gap = Math.Round(Share(progress.Realized, progress) - pace);
                        <div>
                            <dd>@(gap > 0 ? "+" : null)@Texts.Get("crm.dashboard.points", gap.ToString("0", Regional.Numbers))</dd>
                            <dt>@Texts.Get(gap < 0 ? "crm.dashboard.behind-tempo" : "crm.dashboard.ahead-tempo")</dt>
                        </div>
                    }
                </dl>
            }
        </section>

        <div class="dash-kpis" role="group" aria-label="@Texts.Get("crm.dashboard.summary")">
            <DashKpi Label="@Texts.Get("crm.sales-card.realized")" Icon="check-circle" Tone="success" Value="@(amounts ? SalesLabels.Compact(r.Realized.Amount, r.Currency) : SalesLabels.Count(r.WonCount))"
                     Detail="@Texts.Get("crm.dashboard.won-count", r.Realized.Count)" Delta="@RealizedDelta(r).Text" DeltaTrend="@RealizedDelta(r).Trend" Partial="@(amounts && r.Realized.IsPartial)" PartialHint="@SalesLabels.PartialHint(r.Realized)"
                     Trend="@(r.Trend.Select(t => amounts ? t.Realized : t.WonCount).ToList())" />
            <DashKpi Label="@Texts.Get("crm.sales-card.openpipeline")" Icon="layers" Value="@(amounts ? SalesLabels.Compact(r.OpenPipeline.Amount, r.Currency) : SalesLabels.Count(r.OpenPipeline.Count))"
                     Detail="@Texts.Get("crm.dashboard.open-count", r.OpenPipeline.Count)" Partial="@(amounts && r.OpenPipeline.IsPartial)" PartialHint="@SalesLabels.PartialHint(r.OpenPipeline)" />
            <DashKpi Label="@Texts.Get("crm.opportunityReport.winRate")" Icon="target" Tone="teal" Value="@(r.WinRatePercent is { } rate ? SalesLabels.Percent(Math.Round(rate)) : Texts.Get("crm.sales.noData"))"
                     Detail="@(r.WinRatePercent is null ? Texts.Get("crm.dashboard.no-closed") : Texts.Get("crm.dashboard.won-lost", r.WonCount, r.LostCount))"
                     Delta="@WinRateDelta(r).Text" DeltaTrend="@WinRateDelta(r).Trend" />
            <DashKpi Label="@Texts.Get("crm.dashboard.overdue")" Icon="alert-circle" Tone="warning" Value="@SalesLabels.Count(r.OverdueOpenCount)" Detail="@Texts.Get("crm.dashboard.overdue-detail")" />
        </div>

        @if (r.PreviousToDate is { } previous && (RealizedDelta(r).Text is not null || WinRateDelta(r).Text is not null))
        {
            <p class="small text-muted">@Texts.Get("crm.dashboard.delta-note", previous.Label, SalesLabels.Period(previous.Start, previous.LastDay))</p>
        }

        <div class="dash-grid">
            <section class="dash-card" aria-labelledby="dash-trend">
                <div class="dash-card-head"><h2 id="dash-trend">@Texts.Get("crm.dashboard.trend", r.Trend.Count)</h2></div>
                @if (r.Trend.All(t => t.Realized == 0 && t.WonCount == 0))
                {
                    <EmptyState Compact="true" Title="@Texts.Get("crm.dashboard.trend-empty")" />
                }
                else
                {
                    <ColumnChart Title="@(amounts ? Texts.Get("crm.dashboard.trend-chart-amount", r.Currency) : Texts.Get("crm.dashboard.trend-chart-count"))"
                                 Items="@(r.Trend.Select(t => new ColumnChart.Item(SalesLabels.ShortPeriod(t.Label), t.Label, amounts ? t.Realized : t.WonCount, amounts ? SalesLabels.Short(t.Realized) : SalesLabels.Count(t.WonCount))).ToList())" />
                }
            </section>

            <section class="dash-card" aria-labelledby="dash-stage">
                <div class="dash-card-head">
                    <h2 id="dash-stage">@Texts.Get("crm.dashboard.stages")</h2>
                    @if (Session.Can(CrmAccess.OpportunitiesRead))
                    {
                        <a href="crm/firsatlar">@Texts.Get("crm.dashboard.go-opportunities")</a>
                    }
                </div>
                @if (r.ByStage.Count == 0)
                {
                    <EmptyState Compact="true" Title="@Texts.Get("crm.sales.noOpen")" />
                }
                else
                {
                    var stages = OrderedStages(r);
                    var largest = stages.Max(s => amounts ? s.Amount : s.Count);
                    @foreach (var stage in stages)
                    {
                        var size = amounts ? stage.Amount : stage.Count;
                        var width = largest > 0 ? size / largest * 100m : 0m;
                        <div class="dash-stage">
                            <span class="dash-stage-label" title="@StageTitle(stage)">@Lookups.Label(CrmLists.OpportunityStage, stage.Stage)</span>
                            <div><div class="dash-stage-bar" style="width:@width.ToString("0.#", CultureInfo.InvariantCulture)%">@stage.Count</div></div>
                            @if (amounts)
                            {
                                <span class="dash-num">@SalesLabels.Compact(stage.Amount, r.Currency)</span>
                            }
                        </div>
                    }
                    @if (stages.Where(s => s.AverageDaysInStage is not null).MaxBy(s => s.AverageDaysInStage) is { } slowest)
                    {
                        <p class="small text-muted mb-0 mt-3"><AppIcon Name="clock" Size="14" /> @Texts.Get("crm.dashboard.slowest", Lookups.Label(CrmLists.OpportunityStage, slowest.Stage), Days(slowest.AverageDaysInStage!.Value))</p>
                    }
                }
            </section>

            <section class="dash-card" aria-labelledby="dash-risk">
                <div class="dash-card-head">
                    <h2 id="dash-risk">@Texts.Get("crm.dashboard.attention")</h2>
                    @if (r.OverdueOpenCount > AttentionLimit)
                    {
                        <a href="crm/satis-gorunumu">@Texts.Get("crm.dashboard.all-overdue", r.OverdueOpenCount)</a>
                    }
                </div>
                @if (r.Overdue.Count == 0)
                {
                    <EmptyState Compact="true" Title="@Texts.Get("crm.dashboard.attention-empty")" />
                }
                else
                {
                    <ul class="dash-list">
                        @foreach (var risk in r.Overdue.Take(AttentionLimit))
                        {
                            var owner = Lookups.MemberName(risk.OwnerId);
                            <li>
                                @if (!string.IsNullOrEmpty(owner))
                                {
                                    <OwnerCell Name="@owner" AvatarOnly="true" />
                                }
                                <div class="dash-list-main">
                                    <a href="crm/firsatlar/@risk.Id" title="@risk.Title">@risk.Title</a>
                                    <small>@LateText(risk, r.Today)@(" · " + (string.IsNullOrEmpty(owner) ? Texts.Get("crm.leads.unassigned") : owner))</small>
                                </div>
                                @if (risk.Amount is { } value)
                                {
                                    <span class="dash-num">@SalesLabels.Compact(value, risk.Currency)</span>
                                }
                            </li>
                        }
                    </ul>
                }
            </section>
        </div>

        @if (r.Warnings.Count > 0)
        {
            <details class="detail-section">
                <summary><strong>@Texts.Get("crm.sales.warnings") (@r.Warnings.Count)</strong></summary>
                <ul class="small text-muted mt-2 mb-0">
                    @foreach (var warning in r.Warnings)
                    {
                        <li>@warning</li>
                    }
                </ul>
            </details>
        }
    }
    }
</AuthGate>

@code {
    private const int AttentionLimit = 4;
    private const string GoalView = "hedef";
    private const string DayView = "gunum";

    private static IReadOnlyList<ViewOption> Views =>
    [
        new(GoalView, Texts.Get("crm.dashboard.view.goal"), Icon: "target"),
        new(DayView, Texts.Get("crm.dashboard.view.day"), Icon: "calendar"),
    ];

    /// <summary>Açılacak sekme: <c>?gorunum=gunum</c> Benim günüm'ü açar; yoksa Hedef merkezi.</summary>
    [SupplyParameterFromQuery(Name = "gorunum")] public string? ViewParameter { get; set; }

    private string view = GoalView;
    private MyDayPanel? myDay;
    private MyDaySummary? summary;

    private string kind = SalesPeriodKinds.Quarter;
    private string owner = string.Empty;
    private SalesOverviewDto? report;
    private string? error;
    private bool forbidden;
    private bool loading;
    private int requestId;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        // Satış raporu izni yoksa Hedef merkezi yoktur; pano doğrudan Benim günüm açılır.
        view = ViewParameter == DayView || !CanReports ? DayView : GoalView;
        await Lookups.LoadAsync();
        if (CanReports)
        {
            if (view == GoalView)
            {
                await LoadAsync();
            }
        }
    }

    private bool CanReports => Session.Can(SalesAccess.ReportsRead);

    private async Task ChooseViewAsync(string key)
    {
        view = key;
        Nav.NavigateTo(Nav.GetUriWithQueryParameter("gorunum", key == DayView ? DayView : null), replace: true);
        if (view == GoalView && report is null && !loading)
        {
            await LoadAsync();
        }
    }

    // Selamlama: kullanıcının adı ve bugünün iki sayısı (bugünkü açık iş, kapanış tarihi geçmiş fırsat); sayı bilinmiyorsa yazılmaz.
    private string Greeting
    {
        get
        {
            var hour = Regional.Now.Hour;
            var hello = Texts.Get(hour < 12 ? "crm.dashboard.morning" : hour < 18 ? "crm.dashboard.afternoon" : "crm.dashboard.evening");
            var name = Session.User?.DisplayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault();
            var parts = new List<string>();
            if (summary?.OpenToday is { } open)
            {
                parts.Add(open == 0 ? Texts.Get("crm.dashboard.today-none") : Texts.Get("crm.dashboard.today-count", open));
            }

            if (summary?.OverdueOpportunities is { } late && late > 0)
            {
                parts.Add(Texts.Get("crm.dashboard.late-count", late));
            }

            return $"{hello}{(name is null ? null : " " + name)}." + (parts.Count > 0 ? " " + string.Join(", ", parts) + "." : null);
        }
    }

    private string Subtitle
    {
        get
        {
            if (report is not { } r)
            {
                return Texts.Get("crm.dashboard.subtitle");
            }

            var total = r.PeriodEnd.DayNumber - r.PeriodStart.DayNumber + 1;
            var passed = r.Today.DayNumber - r.PeriodStart.DayNumber + 1;
            return passed >= 1 && passed <= total
                ? Texts.Get("crm.dashboard.period-progress", CrmLabels.Date(r.Today), r.PeriodLabel, passed, total)
                : $"{r.PeriodLabel} · {SalesLabels.Period(r.PeriodStart, r.PeriodEnd)}";
        }
    }

    private async Task LoadAsync()
    {
        var id = ++requestId;
        loading = true;
        error = null;
        forbidden = false;

        var query = $"kind={kind}" + (owner.Length > 0 ? $"&ownerId={Uri.EscapeDataString(owner)}" : null);
        var result = await Api.GetAsync<SalesOverviewDto>($"/api/crm/sales/overview?{query}");
        if (id != requestId)
        {
            return;
        }

        loading = false;
        if (result.IsSuccess)
        {
            report = result.Value;
            return;
        }

        report = null;
        error = result.Error;
        forbidden = result.Status == HttpStatusCode.Forbidden;
    }

    private async Task ChooseKindAsync(string key)
    {
        kind = key;
        await LoadAsync();
    }

    private static decimal Share(decimal value, TargetProgressDto progress) => progress.Target > 0 ? value / progress.Target * 100m : 0m;

    private static string Figure(decimal value, SalesOverviewDto r) => r.AmountsVisible ? SalesLabels.Compact(value, r.Currency) : value.ToString("N0", Regional.Numbers);

    private static string MeterLabel(SalesOverviewDto r, TargetProgressDto progress, decimal? tempo) =>
        tempo is { } value
            ? Texts.Get("crm.dashboard.meter-tempo", SalesLabels.Percent(Math.Round(Share(progress.Realized, progress))), SalesLabels.Percent(Math.Round(value)))
            : Texts.Get("crm.dashboard.meter", SalesLabels.Percent(Math.Round(Share(progress.Realized, progress))));

    private static string LateText(OverviewRiskDto risk, DateOnly today) =>
        risk.ExpectedCloseDate is { } due ? Texts.Get("crm.dashboard.days-late", today.DayNumber - due.DayNumber) : Texts.Get("crm.pending.overdue");

    // Gerçekleşen: tutar izni varsa yüzde değişim, yoksa kazanılan adet farkı. Önceki dönemde hiç yoksa oran yazılmaz.
    private static (string? Text, int Trend) RealizedDelta(SalesOverviewDto r)
    {
        if (r.PreviousToDate is not { } previous)
        {
            return (null, 0);
        }

        if (!r.AmountsVisible)
        {
            var gap = r.WonCount - previous.WonCount;
            return ((gap > 0 ? "+" : null) + Texts.Get("crm.sales.countUnit", gap), Math.Sign(gap));
        }

        if (previous.Realized.Amount <= 0)
        {
            return (null, 0);
        }

        var change = Math.Round((r.Realized.Amount - previous.Realized.Amount) / previous.Realized.Amount * 100m);
        return ($"{(change > 0 ? "+" : change < 0 ? "−" : null)}%{Math.Abs(change).ToString("0", Regional.Numbers)}", Math.Sign(change));
    }

    // Kazanma oranı: iki dönemde de sonuçlanan fırsat varsa yüzde puan farkı.
    private static (string? Text, int Trend) WinRateDelta(SalesOverviewDto r)
    {
        if (r.WinRatePercent is not { } now || r.PreviousToDate?.WinRatePercent is not { } before)
        {
            return (null, 0);
        }

        var gap = Math.Round(now - before);
        return ((gap > 0 ? "+" : gap < 0 ? "−" : null) + Texts.Get("crm.dashboard.points", Math.Abs(gap).ToString("0", Regional.Numbers)), Math.Sign(gap));
    }

    private static string Days(decimal days) => days.ToString("0.#", Regional.Numbers);

    private string StageTitle(StageSliceDto stage) =>
        Lookups.Label(CrmLists.OpportunityStage, stage.Stage) + (stage.AverageDaysInStage is { } days ? " · " + Texts.Get("crm.dashboard.stage-days", Days(days)) : null);

    // Aşamalar firmanın tanımladığı sırayla çizilir; listede olmayan (eski) aşama sona gelir.
    private List<StageSliceDto> OrderedStages(SalesOverviewDto r)
    {
        List<string> order = [.. Lookups.ValuesOf(CrmLists.OpportunityStage).Select(v => v.Key)];
        return [.. r.ByStage.OrderBy(s => order.IndexOf(s.Stage) is var at && at >= 0 ? at : int.MaxValue)];
    }
}
