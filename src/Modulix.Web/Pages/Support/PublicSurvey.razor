@page "/anket/{Tenant}"
@layout PublicLayout
@inject ApiClient Api
@inject NavigationManager Navigation

<PageTitle>@Texts.Get("support.public-survey.title") · Modulix</PageTitle>

@* Oturumsuz memnuniyet anketi (ADR-0024 dilim 4). Belirteç adresin # parçasındadır (#t=...): sunucuya, günlüklere ve Referer başlığına gitmez; API çağrılarında gövdede taşınır.
   Anket tek kullanımlık ve süreli; talebin konusu ve numarası dışında bir şey gösterilmez. *@

@if (loading)
{
    <LoadingState />
}
else if (invalid)
{
    <div class="alert alert-warning" role="alert">
        <h1 class="h5">@Texts.Get("crm.public-quote.invalid")</h1>
        <p class="mb-0">@Texts.Get("support.public-survey.invalid-text")</p>
    </div>
}
else if (view is not null)
{
    <article class="public-quote" aria-labelledby="survey-heading">
        <h1 id="survey-heading" class="h4">@Texts.Get("support.public-survey.heading")</h1>
        <p class="text-muted"><strong>@view.TicketNumber</strong> · @view.Subject</p>

        @if (view.State == "answered")
        {
            <div class="alert alert-success" role="status">
                <strong>@Texts.Get("support.public-survey.thanks")</strong> @(view.Rating is { } r ? Texts.Get("support.public-survey.saved-rating", r) : Texts.Get("support.public-survey.saved"))
            </div>
        }
        else if (!view.CanAnswer)
        {
            <div class="alert alert-warning" role="status">@(view.Message ?? Texts.Get("support.public-survey.closed"))</div>
        }
        else
        {
            <Notice Text="@problem" Failed="true" />
            <form novalidate @onsubmit="AnswerAsync" @onsubmit:preventDefault>
                <fieldset disabled="@busy">
                    <legend class="form-label">@Texts.Get("support.public-survey.question")</legend>
                    <div role="radiogroup" aria-label="@Texts.Get("support.public-survey.scale")">
                        @for (var value = 1; value <= 5; value++)
                        {
                            var current = value;
                            <div class="form-check form-check-inline">
                                <input id="rate-@current" class="form-check-input" type="radio" name="rating" checked="@(rating == current)" @onchange="() => rating = current" />
                                <label class="form-check-label" for="rate-@current">@current @Hint(current)</label>
                            </div>
                        }
                    </div>
                    @if (ratingMissing) { <div class="invalid-feedback d-block" role="alert">@Texts.Get("support.public-survey.rating-required")</div> }
                    <label class="form-label mt-3" for="survey-comment">@Texts.Get("support.public-survey.comment")</label>
                    <textarea id="survey-comment" class="form-control" rows="3" maxlength="1000" @bind="comment"></textarea>
                </fieldset>
                <div class="form-actions"><button type="submit" class="btn btn-primary" disabled="@busy" aria-busy="@(busy ? "true" : "false")">@Texts.Get("support.public-survey.submit")</button></div>
            </form>
            <p class="small text-muted mt-2">@Texts.Get("support.public-survey.valid-until", CrmLabels.Time(view.ExpiresAt))</p>
        }
    </article>
}

@code {
    [Parameter] public string Tenant { get; set; } = string.Empty;

    private PublicSurveyView? view;
    private string token = string.Empty;
    private int rating;
    private string comment = string.Empty;
    private string? problem;
    private bool loading = true;
    private bool invalid;
    private bool busy;
    private bool ratingMissing;

    protected override async Task OnInitializedAsync()
    {
        // Sayfa önce tarayıcının diliyle açılır; anket gelince müşterinin diline geçer (ADR-0034 §6).
        await PublicTexts.ApplyAsync(Api, null);
        token = Modulix.Web.Pages.Crm.PublicQuote.TokenFromFragment(Navigation.Uri);
        if (token.Length == 0)
        {
            loading = false;
            invalid = true;
            return;
        }

        var result = await Api.PostAsync<PublicSurveyView>($"/api/public/support-survey/{Uri.EscapeDataString(Tenant)}/view", new PublicSurveyTokenRequest(token));
        if (result.Value is { } loaded)
        {
            await PublicTexts.ApplyAsync(Api, loaded.Language);
        }

        loading = false;
        view = result.Value;
        invalid = view is null;
    }

    private async Task AnswerAsync()
    {
        if (busy) { return; }
        ratingMissing = rating == 0;
        if (ratingMissing) { return; }
        busy = true;
        problem = null;
        var result = await Api.PostAsync<PublicSurveyView>(
            $"/api/public/support-survey/{Uri.EscapeDataString(Tenant)}/answer",
            new PublicSurveyAnswerRequest(token, rating, string.IsNullOrWhiteSpace(comment) ? null : comment.Trim()));
        busy = false;
        if (result.Value is { } updated)
        {
            view = updated;
            return;
        }

        problem = result.Error ?? Texts.Get("support.public-survey.save-failed");
    }

    private static string Hint(int value) => value switch { 1 => Texts.Get("support.public-survey.hint-low"), 5 => Texts.Get("support.public-survey.hint-high"), _ => string.Empty };
}
