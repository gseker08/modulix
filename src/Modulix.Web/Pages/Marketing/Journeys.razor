@page "/pazarlama/yolculuklar"
@inject ApiClient Api
@inject SessionState Session

<PageTitle>@Texts.Get("nav.app.marketing.journeys") · Modulix</PageTitle>

@* Müşteri yolculukları listesi (ADR-0056): görünümler (benim, tümü, durumlar), arama, hedef süzgeci, sıralanabilir sütunlar. Durum ve kapsam sunucuda uygulanır. *@
<AuthGate Module="@MarketingAccess.ModuleKey" Permission="@MarketingAccess.JourneysRead">
    <div class="page-header">
        <div>
            <h1>@Texts.Get("nav.app.marketing.journeys")</h1>
            <p class="text-muted mb-0">@Texts.Get("marketing.journeys.intro")</p>
        </div>
    </div>

    @if (message is not null)
    {
        <div class="alert alert-danger" role="alert">@message <button type="button" class="btn btn-sm btn-outline-secondary ms-2" @onclick="() => LoadAsync(1)">@Texts.Get("crm.sales.retry")</button></div>
    }

    <ViewTabs Items="ViewOptions" Value="@view" ValueChanged="ChooseViewAsync" Label="@Texts.Get("marketing.journeys.views")" />

    <div class="list-toolbar">
        <form class="search" @onsubmit="() => LoadAsync(1)" @onsubmit:preventDefault>
            <label class="visually-hidden" for="journey-search">@Texts.Get("marketing.journeys.search")</label>
            <input id="journey-search" class="form-control" type="search" placeholder="@Texts.Get("marketing.searchPlaceholder")" @bind="search" />
        </form>
        <FilterToggle @bind-Open="filtersOpen" Count="ActiveFilters" />
        <GridColumnPicker State="grid" Changed="@(() => Task.CompletedTask)" />
        @if (Session.Can(MarketingAccess.JourneysWrite))
        {
            <a class="btn btn-primary" href="pazarlama/yolculuklar/yeni"><AppIcon Name="plus" Size="16" /> @Texts.Get("marketing.journeys.new")</a>
        }
    </div>

    @if (filtersOpen || ActiveFilters > 0)
    {
        <div class="filters">
            <label class="visually-hidden" for="journey-target-filter">@Texts.Get("marketing.targetType")</label>
            <select id="journey-target-filter" class="form-select form-select-sm filter-select" @bind="target" @bind:after="() => LoadAsync(1)">
                <option value="">@Texts.Get("marketing.allTargets")</option>
                @foreach (var t in MarketingLabels.Targets) { <option value="@t.Key">@t.Label</option> }
            </select>
        </div>
    }

    @if (list is null && message is null)
    {
        <LoadingState Kind="LoadingKind.Table" />
    }
    else if (list is not null && list.Items.Count == 0)
    {
        <EmptyState Icon="shuffle" Title="@Texts.Get("marketing.journeys.emptyTitle")"
                    Text="@(Session.Can(MarketingAccess.JourneysWrite) ? Texts.Get("marketing.journeys.emptyCanCreate") : Texts.Get("marketing.journeys.empty"))" />
    }
    else if (list is not null)
    {
        <p class="visually-hidden" role="status" aria-live="polite">@Texts.Get("marketing.journeys.listed", list.TotalCount)</p>
        <table class="table record-table">
            <caption class="visually-hidden">@Texts.Get("marketing.journeys.caption")</caption>
            <thead>
                <tr>
                    @foreach (var column in grid.VisibleColumns)
                    {
                        <GridHeader Column="column" State="grid" SortChanged="SortAsync" />
                    }
                    <th scope="col" class="row-menu-cell"><span class="visually-hidden">@Texts.Get("common.actions")</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var j in list.Items)
                {
                    <tr>
                        @foreach (var column in grid.VisibleColumns)
                        {
                            @Cell(column, j)
                        }
                        <td class="row-menu-cell">
                            <RowMenu Label="@Texts.Get("common.rowActionsOf", j.Name)">
                                <a class="view-menu-item" role="menuitem" href="pazarlama/yolculuklar/@j.Id"><AppIcon Name="eye" Size="16" /> <span>@Texts.Get("common.open")</span></a>
                            </RowMenu>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <Pager PageSizeChoice="true" Page="list.Page" PageSize="list.PageSize" TotalCount="list.TotalCount" PageChanged="LoadAsync" />
    }
</AuthGate>

@code {
    private const string AllViews = "all";
    private const string MineView = "mine";
    private const string StatusPrefix = "status:";

    // Başlık tıklamasıyla sıralanan sütunlar sunucudaki sort anahtarlarıdır (JourneyRecordStore.SortKeys).
    private static GridColumnDef[] Columns =>
    [
        new("name", Texts.Get("marketing.segments.col.name"), "type", "name", "-name", Locked: true),
        new("target", Texts.Get("marketing.col.target"), "target", "target", "-target"),
        new("status", Texts.Get("common.field.status"), "tag", "status", "-status"),
        new("reentry", Texts.Get("marketing.journeys.col.reentry"), "shuffle"),
    ];

    private readonly GridViewState grid = new("marketing.journeys", "name");
    private bool filtersOpen;
    private PagedResult<JourneyDto>? list;
    private string? message;
    private string target = string.Empty;
    private string search = string.Empty;
    private string view = AllViews;

    private int ActiveFilters => target.Length > 0 ? 1 : 0;

    // Görünümler yalnızca süzgeçtir (benim, tümü, duruma göre); kapsamı sunucu uygular.
    private IReadOnlyList<ViewOption> ViewOptions =>
    [
        new(MineView, Texts.Get("marketing.journeys.view.mine"), Icon: "star"),
        new(AllViews, Texts.Get("marketing.journeys.view.all"), Icon: "layers"),
        .. MarketingLabels.JourneyStatuses.Select(s => new ViewOption(StatusPrefix + s.Key, s.Label, Icon: "tag")),
    ];

    protected override async Task OnInitializedAsync()
    {
        grid.Define(Columns);
        await Session.EnsureLoadedAsync();
        if (Session.Can(MarketingAccess.JourneysRead))
        {
            await LoadAsync(1);
        }
    }

    private async Task ChooseViewAsync(string key)
    {
        view = key;
        await LoadAsync(1);
    }

    private async Task SortAsync(string key)
    {
        grid.Sort = key;
        await LoadAsync(1);
    }

    private async Task LoadAsync(int pageNumber)
    {
        var parts = new List<string> { $"page={pageNumber}&pageSize={ListPaging.Size}" };
        if (!string.IsNullOrWhiteSpace(search)) { parts.Add($"search={Uri.EscapeDataString(search.Trim())}"); }
        if (grid.Sort != grid.DefaultSort) { parts.Add($"sort={Uri.EscapeDataString(grid.Sort)}"); }
        if (target != string.Empty) { parts.Add($"target={target}"); }
        if (view == MineView) { parts.Add("ownerId=me"); }
        if (view.StartsWith(StatusPrefix, StringComparison.Ordinal)) { parts.Add($"status={view[StatusPrefix.Length..]}"); }

        var result = await Api.GetAsync<PagedResult<JourneyDto>>($"/api/marketing/journeys?{string.Join('&', parts)}");
        list = result.Value;
        message = result.IsSuccess ? null : result.Error;
    }

    private RenderFragment Cell(GridColumnDef column, JourneyDto j) => @<td data-label="@column.Label" class="@(column.Key == "name" ? "primary" : null)">@CellContent(column.Key, j)</td>;

    private RenderFragment CellContent(string key, JourneyDto j) => key switch
    {
        "name" => @<text><a href="pazarlama/yolculuklar/@j.Id">@j.Name</a> <small class="text-muted">@j.Code</small></text>,
        "target" => @<text>@MarketingLabels.Label(MarketingLabels.Targets, j.Target)</text>,
        "status" => @<span class="badge stage-@MarketingLabels.JourneyBadge(j.Status)">@MarketingLabels.Label(MarketingLabels.JourneyStatuses, j.Status)</span>,
        "reentry" => @<text>@MarketingLabels.Label(MarketingLabels.JourneyReentryPolicies, j.ReentryPolicy)</text>,
        _ => @<text></text>,
    };
}
